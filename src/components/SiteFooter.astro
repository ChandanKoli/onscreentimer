---
import { getLocaleFromUrl, getRelativeLocaleUrl } from '../i18n/utils.ts';
import { useTranslations } from '../i18n/ui.ts';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const prefixPath = (path: string) => getRelativeLocaleUrl(locale, path);
---

<footer class="w-full mt-auto border-t border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 py-8 md:py-12 group-data-[size=full]/body:hidden">
	<div class="max-w-7xl mx-auto px-4 sm:px-6">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12">
			<!-- Brand & Description -->
			<div class="md:col-span-1">
				<a href={prefixPath("/")} class="flex items-center gap-2 text-zinc-950 dark:text-zinc-50 font-semibold tracking-tight hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none rounded-sm px-1 py-0.5 -ml-1 mb-3 w-fit" aria-label={t("aria.home")}>
					<span class="w-2.5 h-2.5 rounded-full bg-blue-600 dark:bg-blue-500" aria-hidden="true"></span>
					<span class="text-base font-medium">On Screen Timer</span>
				</a>
				<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-sm">
					{t("footer.description")}
				</p>
			</div>

			<!-- Links Columns -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-8 md:col-span-3">
				<!-- Product -->
				<div class="flex flex-col gap-3">
					<h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">{t("footer.product")}</h3>
					<ul class="flex flex-col gap-2.5">
						<li><a href={prefixPath("/") + "#tool"} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">On Screen Timer</a></li>
					</ul>
				</div>

				<!-- Learn -->
				<div class="flex flex-col gap-3">
					<h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">{t("footer.learn")}</h3>
					<ul class="flex flex-col gap-2.5">
						<li><a href={prefixPath("/guide")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.guide")}</a></li>
						<li><a href={prefixPath("/faq")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.faq")}</a></li>
						<li><a href={prefixPath("/") + "#how-it-works"} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.howItWorks")}</a></li>
					</ul>
				</div>

				<!-- Common Timers -->
				<div class="flex flex-col gap-3">
					<h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">{t("footer.common")}</h3>
					<ul class="flex flex-col gap-2.5">
						<li><a href={prefixPath("/timer/5-minutes")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.5min")}</a></li>
						<li><a href={prefixPath("/timer/10-minutes")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.10min")}</a></li>
						<li><a href={prefixPath("/timer/20-minutes")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.20min")}</a></li>
						<li><a href={prefixPath("/timer/25-minutes")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.25min")}</a></li>
					</ul>
				</div>

				<!-- Legal -->
				<div class="flex flex-col gap-3">
					<h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">{t("footer.legal")}</h3>
					<ul class="flex flex-col gap-2.5">
						<li><a href={prefixPath("/privacy")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.privacy")}</a></li>
						<li><a href={prefixPath("/terms")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.terms")}</a></li>
						<li><a href={prefixPath("/contact")} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">{t("footer.contact")}</a></li>
					</ul>
				</div>
			</div>
		</div>

		<!-- Bottom -->
		<div class="mt-12 pt-8 border-t border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
			<p class="text-sm text-zinc-500 dark:text-zinc-400">
				&copy; 2026 On Screen Timer
			</p>
			<p class="text-sm text-zinc-500 dark:text-zinc-400">
				{t("footer.free")}
			</p>
		</div>
	</div>
</footer>
