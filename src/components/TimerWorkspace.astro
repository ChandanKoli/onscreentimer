---
// TimerWorkspace.astro - Core Workspace supporting Timer, Clock, and Stopwatch with Modern, Digital, and Analog styles
import { generateHourNumerals, generateDialTicks } from '../lib/renderers';

import { getLocaleFromUrl } from '../i18n/utils.ts';
import { useTranslations } from '../i18n/ui.ts';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const numerals = generateHourNumerals();
const ticks = generateDialTicks();
---

<div class="w-full flex flex-col items-center justify-center my-auto py-4 sm:py-6">
	<h1 class="sr-only">On Screen Timer</h1>
	<!-- Time Displays Container (Visual Center of Gravity) -->
	<div class="relative w-full flex flex-col items-center justify-center min-h-[160px] sm:min-h-[200px] my-4 sm:my-6">
		<!-- Modern Display Style -->
		<div
			id="display-modern"
			class="flex items-baseline justify-center tabular-nums font-mono font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 select-none text-[clamp(4rem,13vw,9rem)] group-data-[size=tiny]/body:text-[clamp(3rem,8vw,5rem)] group-data-[size=big]/body:text-[clamp(5rem,18vw,13rem)] group-data-[size=full]/body:text-[clamp(6rem,22vw,18rem)] leading-none transition-all duration-300 motion-reduce:transition-none"
			role="timer"
			aria-live="off"
			aria-atomic="true"
			aria-label={`${t("aria.timerDisplay")}: 00:00`}
		>
			<span id="modern-time-text">00:00</span>
			<span id="modern-time-period" class="hidden text-xl sm:text-2xl ml-2 sm:ml-3 font-sans font-medium tracking-widest text-zinc-500 dark:text-zinc-400 select-none"></span>
		</div>

		<!-- Digital Display Style (Segmented SVG) -->
		<div
			id="display-digital"
			class="hidden w-full max-w-lg group-data-[size=tiny]/body:max-w-sm group-data-[size=big]/body:max-w-2xl group-data-[size=full]/body:max-w-5xl transition-all duration-300 motion-reduce:transition-none items-center justify-center px-4 py-2 mx-auto"
			role="timer"
			aria-live="off"
			aria-atomic="true"
			aria-label={t("aria.digitalDisplay")}
		>
			<div id="digital-svg-container" class="flex justify-center items-center grow">
				<!-- Injected by renderDigitalSvg -->
			</div>
			<!-- Digital AM/PM Badge -->
			<div
				id="digital-ampm-badge"
				class="hidden ml-2 sm:ml-4 px-1.5 py-0.5 sm:px-2 sm:py-1 text-xs sm:text-sm font-semibold tracking-widest rounded border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-500 dark:text-zinc-400 shadow-sm shrink-0"
				aria-hidden="true"
			>
				AM
			</div>
		</div>

		<!-- Analog Display Style (SVG Clock Dial) -->
		<div
			id="display-analog"
			class="hidden flex-col items-center justify-center transition-all duration-300 motion-reduce:transition-none"
			role="timer"
			aria-live="off"
			aria-atomic="true"
			aria-label={t("aria.analogDisplay")}
		>
			<div class="relative w-64 h-64 sm:w-72 sm:h-72 group-data-[size=tiny]/body:w-48 group-data-[size=tiny]/body:h-48 group-data-[size=tiny]/body:sm:w-48 group-data-[size=tiny]/body:sm:h-48 group-data-[size=big]/body:w-72 group-data-[size=big]/body:h-72 group-data-[size=big]/body:sm:w-96 group-data-[size=big]/body:sm:h-96 group-data-[size=full]/body:w-[300px] group-data-[size=full]/body:h-[300px] group-data-[size=full]/body:sm:w-[500px] group-data-[size=full]/body:sm:h-[500px] select-none transition-all duration-300 motion-reduce:transition-none">
				<!-- Analog AM/PM Badge -->
				<div
					id="analog-ampm-badge"
					class="hidden absolute top-2 left-2 sm:top-1/2 sm:left-auto sm:right-full sm:mr-4 sm:-translate-y-1/2 px-1.5 py-0.5 sm:px-2 sm:py-1 text-[10px] sm:text-xs font-semibold tracking-wider rounded border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-500 dark:text-zinc-400 shadow-sm"
					aria-hidden="true"
				>
					AM
				</div>
				<svg
					id="analog-svg"
					viewBox="0 0 300 300"
					class="w-full h-full drop-shadow-xs"
					aria-hidden="true"
				>
					<!-- Dial Face -->
					<circle cx="150" cy="150" r="142" class="fill-white dark:fill-zinc-900 stroke-zinc-300 dark:stroke-zinc-700" stroke-width="2" />
					<circle cx="150" cy="150" r="137" class="fill-none stroke-zinc-100 dark:stroke-zinc-800" stroke-width="1" />

					<!-- Dial Ticks -->
					<g>
						{ticks.map((t) => (
							<line
								x1={t.x1}
								y1={t.y1}
								x2={t.x2}
								y2={t.y2}
								stroke-width={t.isHour ? "2" : "1"}
								class={t.isHour ? "stroke-zinc-600 dark:stroke-zinc-300" : "stroke-zinc-300 dark:stroke-zinc-700"}
							/>
						))}
					</g>

					<!-- Hour Numerals 1..12 -->
					<g class="fill-zinc-800 dark:fill-zinc-200 text-xs font-semibold font-sans select-none" text-anchor="middle" dominant-baseline="central">
						{numerals.map((n) => (
							<text x={n.x} y={n.y}>{n.num}</text>
						))}
					</g>

					<!-- Hands (Centered at 150, 150) -->
					<!-- Hour Hand -->
					<line
						id="hand-hour"
						x1="150"
						y1="150"
						x2="150"
						y2="88"
						class="stroke-zinc-900 dark:stroke-zinc-100"
						stroke-width="5"
						stroke-linecap="round"
						style="transform-box: view-box; transform-origin: 150px 150px;"
						transform="rotate(0 150 150)"
					/>

					<!-- Minute Hand -->
					<line
						id="hand-minute"
						x1="150"
						y1="150"
						x2="150"
						y2="54"
						class="stroke-zinc-700 dark:stroke-zinc-300"
						stroke-width="3"
						stroke-linecap="round"
						style="transform-box: view-box; transform-origin: 150px 150px;"
						transform="rotate(0 150 150)"
					/>

					<!-- Second Hand -->
					<g id="hand-second-group" style="transform-box: view-box; transform-origin: 150px 150px;" transform="rotate(0 150 150)">
						<line
							x1="150"
							y1="172"
							x2="150"
							y2="42"
							class="stroke-blue-600 dark:stroke-blue-500"
							stroke-width="1.5"
							stroke-linecap="round"
						/>
						<circle cx="150" cy="150" r="3.5" class="fill-blue-600 dark:fill-blue-500" />
					</g>

					<!-- Center Cap -->
					<circle cx="150" cy="150" r="2" class="fill-white dark:fill-zinc-900" />
				</svg>
			</div>

			<!-- Integrated Numerical Readout for Timer and Stopwatch -->
			<div
				id="analog-numerical-readout"
				class="hidden mt-3 text-lg sm:text-xl font-mono font-medium tabular-nums text-zinc-800 dark:text-zinc-200 tracking-tight"
			>
				00:00
			</div>
		</div>
	</div>

	<!-- Study Block Preset Phase Label -->
	<div
		id="preset-phase-label"
		class="hidden mb-4 px-4 py-1 text-sm font-medium text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800/50 rounded-full select-none"
		aria-live="polite"
	>
		<!-- Injected via workspace-controller -->
	</div>

	<!-- Primary Controls Area -->
	<!-- 1. Timer Controls Row -->
	<div id="controls-timer" class="flex flex-col items-center gap-3 w-full max-w-2xl mx-auto px-4">
		<div class="flex flex-wrap items-center justify-center gap-1.5 min-[400px]:gap-2 sm:gap-3 w-full">
			<!-- Group 1: Input + Start -->
				<div class="flex items-center gap-1.5 min-[400px]:gap-2 sm:gap-3">
					<!-- Set Timer Input -->
			<form id="timer-form" class="relative flex items-center m-0 p-0" novalidate>
				<label for="timer-input" class="sr-only">{t('aria.setTimerDuration')}</label>
				<input
					id="timer-input"
					type="text"
					value=""
					placeholder={t("timer.placeholder")}
					class="h-10 sm:h-11 px-3 py-2 text-sm rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:focus-visible:ring-blue-400 focus-visible:border-transparent transition-colors w-16 min-[360px]:w-20 min-[400px]:w-24 sm:w-56 disabled:opacity-50 disabled:cursor-not-allowed"
					autocomplete="off"
					spellcheck="false"
					aria-errormessage="timer-input-error"
				/>
			</form>

			<!-- Start / Pause / Resume Button -->
			<button
				type="button"
				id="btn-timer-primary"
				class="h-10 sm:h-11 px-3 min-[400px]:px-4 sm:px-6 rounded-md bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer shadow-xs disabled:opacity-50 disabled:cursor-not-allowed"
				aria-label={t("aria.startTimer")}
			>
				{t("timer.start")}
			</button>

			</div>

				<!-- Group 2: Reset + Stop -->
				<div class="flex items-center gap-1.5 min-[400px]:gap-2 sm:gap-3">
					<!-- Reset Button -->
			<button
				type="button"
				id="btn-timer-reset"
				class="h-10 sm:h-11 px-2.5 min-[400px]:px-3.5 sm:px-4 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-zinc-900"
				aria-label={t("aria.resetTimer")}
				disabled
			>
				{t("timer.reset")}
			</button>

			<!-- Stop Button -->
			<button
				type="button"
				id="btn-timer-stop"
				class="h-10 sm:h-11 px-2.5 min-[400px]:px-3.5 sm:px-4 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-zinc-900"
				aria-label={t("aria.stopTimer")}
				disabled
			>
				{t("timer.stop")}
			</button>
		</div>
			</div>

		<!-- Validation Error Message Feedback -->
		<div
			id="timer-input-error"
			role="alert"
			aria-live="polite"
			class="hidden w-full max-w-sm mt-1 px-3 py-1.5 text-xs font-medium text-center text-rose-700 dark:text-rose-400 bg-rose-50 dark:bg-rose-500/10 border border-rose-200/60 dark:border-rose-500/20 rounded-md"
		>
		</div>
	</div>

	<!-- 2. Stopwatch Controls Row -->
	<div id="controls-stopwatch" class="hidden flex-col items-center gap-3 w-full max-w-2xl mx-auto px-4">
		<div class="flex flex-wrap items-center justify-center gap-1.5 min-[400px]:gap-2 sm:gap-3 w-full">
			<!-- Start / Pause / Resume Button -->
			<button
				type="button"
				id="btn-stopwatch-primary"
				class="h-10 sm:h-11 px-3 min-[400px]:px-4 sm:px-6 rounded-md bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer shadow-xs disabled:opacity-50 disabled:cursor-not-allowed"
				aria-label={t("aria.startStopwatch")}
			>
				{t("stopwatch.start")}
			</button>


				<!-- Group 2: Reset + Stop -->
				<div class="flex items-center gap-1.5 min-[400px]:gap-2 sm:gap-3">
					<!-- Reset Button -->
			<button
				type="button"
				id="btn-stopwatch-reset"
				class="h-10 sm:h-11 px-2.5 min-[400px]:px-3.5 sm:px-4 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-zinc-900"
				aria-label={t("aria.resetStopwatch")}
				disabled
			>
				{t("stopwatch.reset")}
			</button>

			<!-- Stop Button (Preserves final elapsed duration) -->
			<button
				type="button"
				id="btn-stopwatch-stop"
				class="h-10 sm:h-11 px-2.5 min-[400px]:px-3.5 sm:px-4 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-zinc-900"
				aria-label={t("aria.stopStopwatch")}
				disabled
			>
				{t("stopwatch.stop")}
			</button>
		</div>
	</div>
			</div>

	<!-- 3. Clock Controls Row (Clean passive display, no timer controls) -->
	<div id="controls-clock" class="hidden"></div>

	<!-- Lower Workspace Controls Row (MODE ▾ | STYLE ▾ | SIZE ^) -->
	<div class="w-full max-w-2xl mx-auto px-4 mt-8 pt-4 border-t border-zinc-200/60 dark:border-zinc-800/80 flex flex-wrap items-center justify-between gap-4 sm:gap-3 text-xs">
		<!-- Left: Current Task Area -->
		<div id="current-task-container" class="flex-1 text-left flex flex-col gap-2 min-w-0 pr-2 sm:pr-4">
			<!-- Current tasks injected here -->
		</div>

		<!-- Right: Mode, Style, and Size Control Group -->
		<!-- Right: Mode, Style, and Size Control Group -->
			<div class="flex items-center gap-1.5 sm:gap-2 self-start sm:self-auto flex-wrap">
			<!-- Exit Full Button -->
			<button
				type="button"
				id="btn-exit-full"
				class="hidden group-data-[size=full]/body:flex fixed bottom-4 left-4 sm:bottom-6 sm:left-6 z-50 h-8 px-3 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none items-center gap-1.5 cursor-pointer shadow-lg"
				aria-label={t("aria.exitFull")}
			>
				<span>{t("workspace.exitFull")}</span>
			</button>

			<!-- MODE Dropdown -->
			<div class="relative inline-block text-left group-data-[size=full]/body:hidden" id="mode-dropdown-container">
				<button
					type="button"
					id="btn-mode-dropdown"
					aria-haspopup="true"
					aria-expanded="false"
					class="h-8 px-2.5 sm:px-3 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none flex items-center gap-1.5 cursor-pointer shadow-2xs"
					aria-label={`${t("aria.selectMode")}, ${t("aria.currently")} ${t("mode.timer")}`}
				>
					<span class="text-zinc-500 dark:text-zinc-400 font-normal">{t("label.mode")}</span>
					<span class="text-zinc-400 text-[10px]">▾</span>
				</button>

				<!-- Mode Menu (Opens downward) -->
				<div
					id="mode-dropdown-menu"
					role="menu"
					aria-orientation="vertical"
					class="hidden absolute right-0 mt-1 w-32 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1 shadow-lg z-30 focus:outline-none"
				>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="true"
						data-mode="timer"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("mode.timer")}</span>
						<span class="mode-check text-blue-600 dark:text-blue-400">✓</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-mode="clock"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("mode.clock")}</span>
						<span class="mode-check text-blue-600 dark:text-blue-400 hidden">✓</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-mode="stopwatch"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("mode.stopwatch")}</span>
						<span class="mode-check text-blue-600 dark:text-blue-400 hidden">✓</span>
					</button>
				</div>
			</div>

			<!-- STYLE Dropdown -->
			<div class="relative inline-block text-left group-data-[size=full]/body:hidden" id="style-dropdown-container">
				<button
					type="button"
					id="btn-style-dropdown"
					aria-haspopup="true"
					aria-expanded="false"
					class="h-8 px-2.5 sm:px-3 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none flex items-center gap-1.5 cursor-pointer shadow-2xs"
					aria-label={`${t("aria.selectStyle")}, ${t("aria.currently")} ${t("style.modern")}`}
				>
					<span class="text-zinc-500 dark:text-zinc-400 font-normal">{t("label.style")}</span>
					<span class="text-zinc-400 text-[10px]">▾</span>
				</button>

				<!-- Style Menu (Opens downward) -->
				<div
					id="style-dropdown-menu"
					role="menu"
					aria-orientation="vertical"
					class="hidden absolute right-0 mt-1 w-32 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1 shadow-lg z-30 focus:outline-none"
				>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="true"
						data-style="modern"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("style.modern")}</span>
						<span class="style-check text-blue-600 dark:text-blue-400">✓</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-style="digital"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("style.digital")}</span>
						<span class="style-check text-blue-600 dark:text-blue-400 hidden">✓</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-style="analog"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("style.analog")}</span>
						<span class="style-check text-blue-600 dark:text-blue-400 hidden">✓</span>
					</button>
				</div>
			</div>

			<!-- SIZE Dropdown -->
			<div class="relative inline-block text-left group-data-[size=full]/body:fixed group-data-[size=full]/body:bottom-4 group-data-[size=full]/body:right-4 group-data-[size=full]/body:sm:bottom-6 group-data-[size=full]/body:sm:right-6 group-data-[size=full]/body:z-50" id="size-dropdown-container">
				<button
					type="button"
					id="btn-size-dropdown"
					aria-haspopup="true"
					aria-expanded="false"
					class="h-8 px-2.5 sm:px-3 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none flex items-center gap-1.5 cursor-pointer shadow-2xs group-data-[size=full]/body:shadow-lg"
					aria-label={`${t("aria.selectSize")}, ${t("aria.currently")} ${t("size.mid")}`}
				>
					<span class="text-zinc-500 dark:text-zinc-400 font-normal">{t("label.size")}</span>
					<span class="text-zinc-400 text-[10px] group-data-[size=full]/body:hidden">▾</span>
					<span class="text-zinc-400 text-[10px] hidden group-data-[size=full]/body:inline">^</span>
				</button>

				<!-- Size Menu (Context-aware positioning: downward normally, upward in Full mode) -->
				<div
					id="size-dropdown-menu"
					role="menu"
					aria-orientation="vertical"
					class="hidden absolute right-0 top-full mt-1 group-data-[size=full]/body:top-auto group-data-[size=full]/body:bottom-full group-data-[size=full]/body:mt-0 group-data-[size=full]/body:mb-1 w-32 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1 shadow-lg z-50 focus:outline-none"
				>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-size="full"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("size.full")}</span>
						<span class="size-check text-blue-600 dark:text-blue-400 hidden">●</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-size="big"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("size.big")}</span>
						<span class="size-check text-blue-600 dark:text-blue-400 hidden">●</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="true"
						data-size="mid"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("size.mid")}</span>
						<span class="size-check text-blue-600 dark:text-blue-400">●</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-size="tiny"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>{t("size.tiny")}</span>
						<span class="size-check text-blue-600 dark:text-blue-400 hidden">●</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</div>
