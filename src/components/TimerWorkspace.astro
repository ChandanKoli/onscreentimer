---
// TimerWorkspace.astro - Core Workspace supporting Timer, Clock, and Stopwatch with Modern, Digital, and Analog styles
import { generateHourNumerals, generateDialTicks } from '../lib/renderers';

const numerals = generateHourNumerals();
const ticks = generateDialTicks();
---

<div class="w-full flex flex-col items-center justify-center my-auto py-4 sm:py-6">
	<!-- Time Displays Container (Visual Center of Gravity) -->
	<div class="relative w-full flex flex-col items-center justify-center min-h-[160px] sm:min-h-[200px] my-4 sm:my-6">
		<!-- Modern Display Style -->
		<div
			id="display-modern"
			class="flex items-baseline justify-center tabular-nums font-mono font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 select-none text-[clamp(4rem,13vw,9rem)] leading-none transition-colors duration-200"
			role="timer"
			aria-live="off"
			aria-atomic="true"
			aria-label="Timer: 00:00"
		>
			<span id="modern-time-text">00:00</span>
			<span id="modern-time-period" class="hidden text-xl sm:text-2xl ml-2 sm:ml-3 font-sans font-medium text-zinc-500 dark:text-zinc-400 select-none"></span>
		</div>

		<!-- Digital Display Style (Segmented SVG) -->
		<div
			id="display-digital"
			class="hidden w-full max-w-lg items-center justify-center px-4 py-2"
			role="timer"
			aria-live="off"
			aria-atomic="true"
			aria-label="Digital Display"
		>
			<div id="digital-svg-container" class="w-full flex justify-center items-center">
				<!-- Injected by renderDigitalSvg -->
			</div>
		</div>

		<!-- Analog Display Style (SVG Clock Dial) -->
		<div
			id="display-analog"
			class="hidden flex-col items-center justify-center"
			role="timer"
			aria-live="off"
			aria-atomic="true"
			aria-label="Analog Display"
		>
			<div class="relative w-64 h-64 sm:w-72 sm:h-72 select-none">
				<svg
					id="analog-svg"
					viewBox="0 0 300 300"
					class="w-full h-full drop-shadow-xs"
					aria-hidden="true"
				>
					<!-- Dial Face -->
					<circle cx="150" cy="150" r="142" class="fill-white dark:fill-zinc-900 stroke-zinc-300 dark:stroke-zinc-700" stroke-width="2" />
					<circle cx="150" cy="150" r="137" class="fill-none stroke-zinc-100 dark:stroke-zinc-800" stroke-width="1" />

					<!-- Dial Ticks -->
					<g>
						{ticks.map((t) => (
							<line
								x1={t.x1}
								y1={t.y1}
								x2={t.x2}
								y2={t.y2}
								stroke-width={t.isHour ? "2" : "1"}
								class={t.isHour ? "stroke-zinc-600 dark:stroke-zinc-300" : "stroke-zinc-300 dark:stroke-zinc-700"}
							/>
						))}
					</g>

					<!-- Hour Numerals 1..12 -->
					<g class="fill-zinc-800 dark:fill-zinc-200 text-xs font-semibold font-sans select-none" text-anchor="middle" dominant-baseline="central">
						{numerals.map((n) => (
							<text x={n.x} y={n.y}>{n.num}</text>
						))}
					</g>

					<!-- Hands (Centered at 150, 150) -->
					<!-- Hour Hand -->
					<line
						id="hand-hour"
						x1="150"
						y1="150"
						x2="150"
						y2="88"
						class="stroke-zinc-900 dark:stroke-zinc-100"
						stroke-width="5"
						stroke-linecap="round"
						style="transform-box: view-box; transform-origin: 150px 150px;"
						transform="rotate(0 150 150)"
					/>

					<!-- Minute Hand -->
					<line
						id="hand-minute"
						x1="150"
						y1="150"
						x2="150"
						y2="54"
						class="stroke-zinc-700 dark:stroke-zinc-300"
						stroke-width="3"
						stroke-linecap="round"
						style="transform-box: view-box; transform-origin: 150px 150px;"
						transform="rotate(0 150 150)"
					/>

					<!-- Second Hand -->
					<g id="hand-second-group" style="transform-box: view-box; transform-origin: 150px 150px;" transform="rotate(0 150 150)">
						<line
							x1="150"
							y1="172"
							x2="150"
							y2="42"
							class="stroke-blue-600 dark:stroke-blue-500"
							stroke-width="1.5"
							stroke-linecap="round"
						/>
						<circle cx="150" cy="150" r="3.5" class="fill-blue-600 dark:fill-blue-500" />
					</g>

					<!-- Center Cap -->
					<circle cx="150" cy="150" r="2" class="fill-white dark:fill-zinc-900" />
				</svg>
			</div>

			<!-- Integrated Numerical Readout for Timer and Stopwatch -->
			<div
				id="analog-numerical-readout"
				class="hidden mt-3 text-lg sm:text-xl font-mono font-medium tabular-nums text-zinc-800 dark:text-zinc-200 tracking-tight"
			>
				00:00
			</div>
		</div>
	</div>

	<!-- Primary Controls Area -->
	<!-- 1. Timer Controls Row -->
	<div id="controls-timer" class="flex flex-col items-center gap-3 w-full max-w-xl mx-auto px-4">
		<div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 w-full">
			<!-- Set Timer Input -->
			<form id="timer-form" class="relative flex items-center m-0 p-0" novalidate>
				<label for="timer-input" class="sr-only">Set timer duration</label>
				<input
					id="timer-input"
					type="text"
					value=""
					placeholder="eg: 2mins, 02:00, 1hr 30mins, 90s"
					class="h-10 sm:h-11 px-3 py-2 text-sm rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:focus-visible:ring-blue-400 focus-visible:border-transparent transition-colors w-48 sm:w-56 disabled:opacity-50 disabled:cursor-not-allowed"
					autocomplete="off"
					spellcheck="false"
				/>
			</form>

			<!-- Start / Pause / Resume Button -->
			<button
				type="button"
				id="btn-timer-primary"
				class="h-10 sm:h-11 px-5 sm:px-6 rounded-md bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer shadow-xs disabled:opacity-50 disabled:cursor-not-allowed"
				aria-label="Start timer"
			>
				Start
			</button>

			<!-- Reset Button -->
			<button
				type="button"
				id="btn-timer-reset"
				class="h-10 sm:h-11 px-3.5 sm:px-4 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-zinc-900"
				aria-label="Reset timer"
				disabled
			>
				Reset
			</button>

			<!-- Stop Button -->
			<button
				type="button"
				id="btn-timer-stop"
				class="h-10 sm:h-11 px-3.5 sm:px-4 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-zinc-900"
				aria-label="Stop timer"
				disabled
			>
				Stop
			</button>
		</div>

		<!-- Validation Error Message Feedback -->
		<div
			id="timer-input-error"
			role="alert"
			aria-live="polite"
			class="hidden text-xs text-rose-600 dark:text-rose-400 font-medium text-center"
		>
		</div>
	</div>

	<!-- 2. Stopwatch Controls Row -->
	<div id="controls-stopwatch" class="hidden flex-col items-center gap-3 w-full max-w-xl mx-auto px-4">
		<div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 w-full">
			<!-- Start / Pause / Resume Button -->
			<button
				type="button"
				id="btn-stopwatch-primary"
				class="h-10 sm:h-11 px-5 sm:px-6 rounded-md bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer shadow-xs disabled:opacity-50 disabled:cursor-not-allowed"
				aria-label="Start stopwatch"
			>
				Start
			</button>

			<!-- Reset Button -->
			<button
				type="button"
				id="btn-stopwatch-reset"
				class="h-10 sm:h-11 px-3.5 sm:px-4 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-zinc-900"
				aria-label="Reset stopwatch"
				disabled
			>
				Reset
			</button>

			<!-- Stop Button (Preserves final elapsed duration) -->
			<button
				type="button"
				id="btn-stopwatch-stop"
				class="h-10 sm:h-11 px-3.5 sm:px-4 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 flex items-center justify-center cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-zinc-900"
				aria-label="Stop stopwatch"
				disabled
			>
				Stop
			</button>
		</div>
	</div>

	<!-- 3. Clock Controls Row (Clean passive display, no timer controls) -->
	<div id="controls-clock" class="hidden"></div>

	<!-- Lower Workspace Controls Row (MODE ▾ | STYLE ▾ | SIZE ^) -->
	<div class="w-full max-w-xl mx-auto px-4 mt-8 pt-4 border-t border-zinc-200/60 dark:border-zinc-800/80 flex items-center justify-between gap-3 text-xs">
		<!-- Left: Task area placeholder (deferred to later phases) -->
		<div class="flex-1 text-left">
			<span class="sr-only">Task area</span>
		</div>

		<!-- Right: Mode, Style, and Size Control Group -->
		<div class="flex items-center gap-2">
			<!-- MODE Dropdown -->
			<div class="relative inline-block text-left" id="mode-dropdown-container">
				<button
					type="button"
					id="btn-mode-dropdown"
					aria-haspopup="true"
					aria-expanded="false"
					class="h-8 px-2.5 sm:px-3 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none flex items-center gap-1.5 cursor-pointer shadow-2xs"
					aria-label="Select mode, currently Timer"
				>
					<span class="text-zinc-500 dark:text-zinc-400 font-normal">MODE</span>
					<span class="text-zinc-400 text-[10px]">▾</span>
				</button>

				<!-- Mode Menu (Opens downward) -->
				<div
					id="mode-dropdown-menu"
					role="menu"
					aria-orientation="vertical"
					class="hidden absolute right-0 mt-1 w-32 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1 shadow-lg z-30 focus:outline-none"
				>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="true"
						data-mode="timer"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>Timer</span>
						<span class="mode-check text-blue-600 dark:text-blue-400">✓</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-mode="clock"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>Clock</span>
						<span class="mode-check text-blue-600 dark:text-blue-400 hidden">✓</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-mode="stopwatch"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>Stopwatch</span>
						<span class="mode-check text-blue-600 dark:text-blue-400 hidden">✓</span>
					</button>
				</div>
			</div>

			<!-- STYLE Dropdown -->
			<div class="relative inline-block text-left" id="style-dropdown-container">
				<button
					type="button"
					id="btn-style-dropdown"
					aria-haspopup="true"
					aria-expanded="false"
					class="h-8 px-2.5 sm:px-3 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none flex items-center gap-1.5 cursor-pointer shadow-2xs"
					aria-label="Select style, currently Modern"
				>
					<span class="text-zinc-500 dark:text-zinc-400 font-normal">STYLE</span>
					<span class="text-zinc-400 text-[10px]">▾</span>
				</button>

				<!-- Style Menu (Opens downward) -->
				<div
					id="style-dropdown-menu"
					role="menu"
					aria-orientation="vertical"
					class="hidden absolute right-0 mt-1 w-32 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 py-1 shadow-lg z-30 focus:outline-none"
				>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="true"
						data-style="modern"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>Modern</span>
						<span class="style-check text-blue-600 dark:text-blue-400">✓</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-style="digital"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>Digital</span>
						<span class="style-check text-blue-600 dark:text-blue-400 hidden">✓</span>
					</button>
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-style="analog"
						class="w-full text-left px-3 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 flex items-center justify-between cursor-pointer focus-visible:bg-zinc-100 dark:focus-visible:bg-zinc-800 focus-visible:outline-none"
					>
						<span>Analog</span>
						<span class="style-check text-blue-600 dark:text-blue-400 hidden">✓</span>
					</button>
				</div>
			</div>

			<!-- SIZE Placeholder (Inert for layout continuity per Phase 3 scope) -->
			<button
				type="button"
				id="btn-size-selector"
				disabled
				aria-disabled="true"
				class="h-8 px-2.5 sm:px-3 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 text-zinc-400 dark:text-zinc-600 cursor-not-allowed flex items-center gap-1 select-none"
				aria-label="Size selector unavailable"
			>
				<span>SIZE</span>
				<span class="text-[10px] text-zinc-400 dark:text-zinc-600">^</span>
			</button>
		</div>
	</div>
</div>
