---
// ProgressModal.astro
---

<div id="progress-modal-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden">
  <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-2xl flex flex-col max-w-6xl w-[95%] p-8 overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-200 dark:border-zinc-800">
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Yearly Progress</h2>
      <div class="flex items-center gap-2">
        <button type="button" id="btn-modal-full" class="p-1.5 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400" aria-label="Full Page" title="Full Page">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
        </button>
        <button type="button" id="btn-modal-minimize" class="p-1.5 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400" aria-label="Minimize" title="Minimize">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <button type="button" id="btn-modal-close" class="p-1.5 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400" aria-label="Close" title="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    </div>
    
    <!-- Grid UI Container -->
    <div class="border border-slate-700/50 rounded-lg p-5 mt-4 w-full overflow-x-auto pb-4 md:w-max md:overflow-hidden md:mx-auto">
      <div class="w-max mx-auto flex gap-2">
        <!-- Y-Axis -->
        <div class="flex flex-col gap-1 pt-5 text-xs text-slate-400 leading-3 text-right">
          <div class="h-3"></div>
          <div class="h-3 flex items-center justify-end">Mon</div>
          <div class="h-3"></div>
          <div class="h-3 flex items-center justify-end">Wed</div>
          <div class="h-3"></div>
          <div class="h-3 flex items-center justify-end">Fri</div>
          <div class="h-3"></div>
        </div>
        
        <!-- X-Axis + Grid -->
        <div class="flex flex-col gap-1 w-max">
          <div id="progress-months" class="flex text-[10px] text-slate-400 mb-2 pl-8 justify-between w-full">
            <!-- Labels injected via JS -->
          </div>
          <div id="progress-modal-grid" class="grid grid-rows-7 grid-flow-col gap-1 w-max">
            <!-- Cells injected via JS -->
          </div>
        </div>
      </div>

      <!-- Footer Legend -->
      <div class="flex justify-between items-center mt-4 text-[11px] text-slate-400 w-full">
        <a href="/guide/progress" class="hover:text-slate-300">Learn how we count progress</a>
        <div class="flex items-center gap-1">
          <span>Less</span>
          <div id="progress-legend-container" class="flex items-center gap-1"></div>
          <span>More</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function renderYearlyHeatmap() {
    const grid = document.getElementById('progress-modal-grid');
    const monthsContainer = document.getElementById('progress-months');
    if (!grid || !monthsContainer) return;

    // Load data
    let data = {};
    try {
      const stored = localStorage.getItem('ost_progress_data');
      if (stored) data = JSON.parse(stored);
    } catch (e) {}

    const today = new Date();
    // clear time to avoid daylight saving issues during offset math
    today.setHours(0, 0, 0, 0);

    const oldestDate = new Date(today);
    oldestDate.setDate(oldestDate.getDate() - 364);
    
    // The Fix: calculate padDays to offset the first grid item
    const padDays = oldestDate.getDay(); // 0 for Sun, 1 for Mon, etc.

    // Generate 365 cells chronological (oldest to newest)
    const gridFragment = document.createDocumentFragment();
    
    // Inject padDays number of invisible cells
    for (let p = 0; p < padDays; p++) {
      const padCell = document.createElement('div');
      padCell.className = 'w-3 h-3 invisible';
      gridFragment.appendChild(padCell);
    }

    const currentTheme = localStorage.getItem('ost_progress_theme') || 'blue';
    const themeColors: Record<string, string[]> = {
      blue: ['bg-slate-100 dark:bg-slate-800', 'bg-blue-300 dark:bg-blue-900', 'bg-blue-500 dark:bg-blue-700', 'bg-blue-600 dark:bg-blue-500'],
      emerald: ['bg-slate-100 dark:bg-slate-800', 'bg-emerald-300 dark:bg-emerald-900', 'bg-emerald-500 dark:bg-emerald-700', 'bg-emerald-600 dark:bg-emerald-500'],
      violet: ['bg-slate-100 dark:bg-slate-800', 'bg-violet-300 dark:bg-violet-900', 'bg-violet-500 dark:bg-violet-700', 'bg-violet-600 dark:bg-violet-500'],
      rose: ['bg-slate-100 dark:bg-slate-800', 'bg-rose-300 dark:bg-rose-900', 'bg-rose-500 dark:bg-rose-700', 'bg-rose-600 dark:bg-rose-500']
    };

    for (let i = 364; i >= 0; i--) {
      const d = new Date(today);
      d.setDate(d.getDate() - i);
      
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      const dateStr = `${year}-${month}-${day}`;
      
      const count = data[dateStr] || 0;
      let bgClass = themeColors[currentTheme][0];
      if (count === 1) bgClass = themeColors[currentTheme][1];
      else if (count === 2) bgClass = themeColors[currentTheme][2];
      else if (count >= 3) bgClass = themeColors[currentTheme][3];

      const cell = document.createElement('div');
      cell.className = `w-3 h-3 rounded-[2px] ${bgClass} transition-colors`;
      cell.title = `${dateStr}: ${count} task${count === 1 ? '' : 's'}`;
      
      gridFragment.appendChild(cell);
    }

    const legendContainer = document.getElementById('progress-legend-container');
    if (legendContainer) {
      legendContainer.innerHTML = '';
      themeColors[currentTheme].forEach(bgClass => {
        const item = document.createElement('div');
        item.className = `w-3 h-3 rounded-[2px] ${bgClass}`;
        legendContainer.appendChild(item);
      });
    }
    
    // Month labels: Render the 12 month labels evenly spaced
    const monthNames = [];
    for (let m = 0; m < 12; m++) {
      const tempDate = new Date(oldestDate);
      tempDate.setMonth(oldestDate.getMonth() + m);
      monthNames.push(`<span>${tempDate.toLocaleString('default', { month: 'short' })}</span>`);
    }
    monthsContainer.innerHTML = monthNames.join('');
    
    grid.innerHTML = '';
    grid.appendChild(gridFragment);
  }

  // Setup header buttons
  const modalOverlay = document.getElementById('progress-modal-overlay');
  
  const btnClose = document.getElementById('btn-modal-close');
  if (btnClose && modalOverlay) {
    btnClose.addEventListener('click', () => {
      modalOverlay.classList.add('hidden');
    });
  }

  const btnFull = document.getElementById('btn-modal-full');
  if (btnFull) {
    btnFull.addEventListener('click', () => {
      console.log('Full page view pending');
    });
  }

  const btnMinimize = document.getElementById('btn-modal-minimize');
  if (btnMinimize && modalOverlay) {
    btnMinimize.addEventListener('click', () => {
      modalOverlay.classList.add('hidden');
      const miniCal = document.getElementById('progress-calendar-wrapper');
      if (miniCal) {
        miniCal.classList.add('hidden');
      }
    });
  }

  // Optional: close on background click
  if (modalOverlay) {
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) {
        modalOverlay.classList.add('hidden');
      }
    });
  }

  // Re-render when modal is opened to show latest data
  // Using MutationObserver to detect when 'hidden' class is removed
  if (modalOverlay) {
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
          if (!modalOverlay.classList.contains('hidden')) {
            renderYearlyHeatmap();
          }
        }
      });
    });
    observer.observe(modalOverlay, { attributes: true });
  }

  // Initial render just in case
  renderYearlyHeatmap();
</script>
