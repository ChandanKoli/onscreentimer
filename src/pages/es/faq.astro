---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

interface FAQItem {
	question: string;
	answer: string;
}

const faqs: FAQItem[] = [
	{
		question: "¿Cómo configuro un temporizador online?",
		answer: "Primero asegúrate de tener seleccionado el modo Temporizador en la barra superior. Introduce la duración deseada en el campo usando formatos como <code>5</code>, <code>02:00</code>, <code>25m</code> o <code>01:30:00</code>. Luego haz clic en Iniciar o pulsa la Barra espaciadora."
	},
	{
		question: "¿Necesito una cuenta para usar On Screen Timer?",
		answer: "No se requiere cuenta ni registro para el uso habitual. Está listo para usar de inmediato, sin muros de pago, inicios de sesión ni rastreo de usuarios."
	},
	{
		question: "¿Qué sucede si recargo la página o cierro el navegador?",
		answer: "Tu temporizador activo, tiempos de vuelta del cronómetro, listas de tareas, bloques de estudio personalizados y preferencias de sonido o tema se guardan localmente en el <code>localStorage</code> del navegador y se restauran automáticamente al volver."
	},
	{
		question: "¿Qué es el modo de Pantalla completa y cómo se activa?",
		answer: "El modo de pantalla completa oculta menús y encabezados superfluos para ofrecer una vista enfocada y despejada. Mantiene visibles únicamente los controles principales y los números en gran tamaño. Pulsa <code>F</code> para alternar la pantalla completa."
	},
	{
		question: "¿Cómo funcionan los Bloques de estudio (Study Blocks)?",
		answer: "Elige una plantilla en los Ajustes —como Pomodoro clásico (25/5) o bloques 50/10. El temporizador avanzará automáticamente por las fases de trabajo y descanso con avisos sonoros al cambiar de intervalo."
	},
	{
		question: "¿Puedo usar On Screen Timer como temporizador Pomodoro?",
		answer: "Sí. Puedes configurar manualmente 25 minutos de trabajo y 5 minutos de descanso, o activar la plantilla Pomodoro integrada en los Ajustes para ejecutar ciclos continuos automáticos."
	},
	{
		question: "¿Cómo evita el Bloqueo de pantalla (Screen Wake Lock) que mi dispositivo se apague durante una cuenta regresiva?",
		answer: "On Screen Timer utiliza la API nativa Screen Wake Lock del navegador para evitar que la pantalla se atenúe, se bloquee o entre en suspensión mientras un temporizador o cronómetro está activo. Se activa automáticamente al iniciar y se libera al pausar o terminar. Mantener la pestaña visible asegura que la pantalla permanezca encendida en exámenes, presentaciones o entrenamientos."
	},
	{
		question: "¿Qué atajos de teclado y controles a pantalla completa están disponibles para presentaciones y exámenes?",
		answer: "Puedes controlar On Screen Timer rápidamente con atajos intuitivos: presiona la <code>Barra espaciadora</code> para iniciar o pausar, <code>R</code> para reiniciar el tiempo inicial y <code>F</code> para alternar el modo de pantalla completa. En este modo se ocultan distracciones y menús, dejando números grandes y de alto contraste legibles a larga distancia en aulas y salas de reuniones."
	},
	{
		question: "¿Cómo protege el almacenamiento local del navegador mis listas de tareas y tiempos de vuelta?",
		answer: "Todos los datos de tu sesión —listas de tareas pendientes, tareas completadas, ajustes de bloques de estudio, preferencias de sonido y registros del cronómetro— se guardan exclusivamente en el almacenamiento local de tu navegador (<code>localStorage</code>). No se envían datos a servidores externos ni bases de datos en la nube, garantizando total privacidad y funcionamiento sin conexión."
	},
	{
		question: "¿Cómo utilizar intervalos Pomodoro y 50/10 para sesiones de estudio profundo?",
		answer: "La técnica 50/10 combina 50 minutos de trabajo ininterrumpido con 10 minutos de descanso reparador, excelente para tareas complejas. Selecciona la plantilla 50/10 o Pomodoro (25/5) en los Ajustes; el temporizador avanzará automáticamente entre fases y emitirá avisos sonoros al cambiar de ciclo."
	},
	{
		question: "¿Por qué no sonó la alarma cuando la pestaña estaba en segundo plano?",
		answer: "Los navegadores modernos aplican políticas estrictas contra la reproducción automática de sonido en pestañas inactivas. Para garantizar que las alertas suenen: 1) Haz clic en la página o pulsa una tecla tras cargarla para conceder permisos de audio; 2) Comprueba que la pestaña no esté silenciada en el navegador; 3) Verifica el volumen del sistema y que no esté activo el interruptor de silencio físico de tu dispositivo."
	},
	{
		question: "¿Cuál es la diferencia entre Temporizador, Reloj digital y Cronómetro con vueltas?",
		answer: "On Screen Timer ofrece tres herramientas en una sola aplicación: 1) <strong>Temporizador de cuenta regresiva:</strong> Cuenta hacia atrás desde una duración fija hasta cero con señales sonoras, ideal para plazos, cocina y exámenes; 2) <strong>Reloj digital:</strong> Muestra la hora local exacta en formato de 12 o 24 horas con segundos en vivo; 3) <strong>Cronómetro con vueltas:</strong> Cuenta hacia adelante con precisión de milisegundos e incluye una tabla de registro de vueltas y tiempos parciales para entrenamientos y productividad."
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqs.map((faq) => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.answer.replace(/<[^>]*>?/gm, '')
		}
	}))
};
---

<Layout title="Preguntas frecuentes — On Screen Timer" description="Preguntas frecuentes sobre On Screen Timer: temporizador online, gestión de tareas, modo de pantalla completa, bloqueo de suspensión y guardado de sesión.">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	</Fragment>
	<div class="min-h-dvh flex flex-col justify-between">
		<SiteHeader />
		<main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
			<h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 mb-8">Preguntas frecuentes</h1>

			<div class="space-y-4">
				{faqs.map((faq, index) => (
					<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900" open={index === 0}>
						<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
							{faq.question}
							<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
						</summary>
						<div class="p-4 pt-0 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed space-y-2">
							<p set:html={faq.answer} />
						</div>
					</details>
				))}
			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>
