---
import Layout from '../../layouts/Layout.astro';
import { getLocaleFromUrl } from '../../i18n/utils.ts';
import { useTranslations } from '../../i18n/ui.ts';
import TimerWorkspace from '../../components/TimerWorkspace.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout title="On Screen Timer — Temporizador online, Reloj y Cronómetro" description="Un temporizador online gratuito, reloj y cronómetro con gestión de tareas integrada. Simple, sin distracciones, funciona directamente en tu navegador.">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "On Screen Timer",
			"url": "https://onscreentimer.com/"
		})} />
	</Fragment>

	<!-- Viewport Wrapper --><div class="flex flex-col min-h-[100svh]">
		<!-- Header -->
		<SiteHeader />

		<!-- Main Workspace Foundation -->
		<main id="tool" class="scroll-mt-28 flex-1 lg:min-h-[calc(100dvh-3.5rem)] max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 lg:py-12 flex flex-col lg:flex-row items-center justify-center gap-6 lg:gap-12 group-data-[size=full]/body:items-center">

			<!-- Reopen Button (Desktop Minimized State) -->
			<button type="button" id="btn-desktop-todo-reopen" class="hidden fixed left-0 top-1/2 -translate-y-1/2 w-6 h-16 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 border-l-0 rounded-r-md shadow-sm items-center justify-center text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400 group-data-[size=full]/body:!hidden transition-colors z-40" aria-label={t("aria.reopenTodo")} title={t("tasks.todo")}>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
			</button>

			<!-- Central Time Workspace -->
			<div class="flex-1 flex flex-col items-center justify-center w-full min-w-0 order-1 lg:order-2">
				<TimerWorkspace />
			</div>

			<!-- Mini To-do Panel (Left on Desktop, stacked below on Mobile) -->
			<aside id="todo-panel" class="w-full max-w-md lg:w-72 lg:max-w-none flex flex-col border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900 shadow-sm p-4 shrink-0 order-2 lg:order-1 group-data-[size=full]/body:hidden transition-all overflow-hidden lg:overflow-visible">
				<!-- Mobile Header -->
					<div class="lg:hidden flex items-center justify-between w-full">
						<button type="button" id="btn-mobile-todo-toggle" aria-expanded="false" aria-controls="todo-content" class="flex items-center text-left font-medium text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							<span class="text-sm mr-4">To-do <span id="todo-mobile-count" class="text-zinc-500 font-normal ml-2"></span></span>
						</button>
						<div class="flex items-center gap-3">
							<button type="button" id="btn-end-all-mobile" class="text-xs font-medium text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400 rounded transition-colors hidden">{t("tasks.endAll")}</button>
							<button type="button" id="btn-mobile-todo-toggle-chevron" class="focus-visible:outline-none rounded-sm text-zinc-400" aria-label={t("aria.minimizeTodo")} tabindex="-1">
								<svg id="todo-mobile-chevron" class="w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
							</button>
						</div>
					</div>

				<!-- Desktop Header -->
				<div class="hidden lg:flex items-center justify-between mb-4">
					<h2 class="text-sm font-medium text-zinc-900 dark:text-zinc-100 text-left">
						Tareas
					</h2>
					<button type="button" id="btn-desktop-todo-minimize" class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400 rounded p-0.5" aria-label={t("aria.minimizeTodo")} title={t("aria.minimize")}>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
					</button>
				</div>

				<!-- Expandable Content -->
				<div id="todo-content" class="hidden lg:flex flex-col mt-4 lg:mt-0">
					<form id="todo-form" class="relative flex items-center mb-4">
						<input type="text" id="todo-input" placeholder={t("tasks.addPlaceholder")} class="w-full h-9 px-3 pr-9 text-sm rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 transition-colors" autocomplete="off" />
						<button type="submit" class="absolute right-1 w-7 h-7 flex items-center justify-center text-zinc-500 hover:text-blue-600 dark:hover:text-blue-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded" aria-label={t("aria.addTask")}>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
						</button>
					</form>
					<div id="todo-list" class="flex flex-col gap-2 overflow-y-auto max-h-[50vh] text-left">
						<!-- Tasks will be rendered here -->
					</div>
					<!-- Task Summary -->
					<div id="todo-summary" class="hidden mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800/80 text-[11px] text-zinc-500 dark:text-zinc-400 font-medium text-center">
						Completadas <span id="count-done">0</span> &middot; Restantes <span id="count-remaining">0</span>
					</div>
				</div>
			</aside>
		</main></div>

		<!-- Comment ça marche Section -->
		<section id="how-it-works" class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-12 lg:py-16 border-t border-zinc-200 dark:border-zinc-800 group-data-[size=full]/body:hidden">
			<h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-8 text-center sm:text-left">Cómo funciona</h2>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
				<!-- Carte 1 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">01</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Elige un modo</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Usa el Temporizador, Reloj o Cronómetro dependiendo de si quieres hacer una cuenta regresiva, ver la hora actual o medir el tiempo transcurrido.
					</p>
				</div>
				<!-- Carte 2 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">02</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Configura e inicia</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Introduce una duración como <code>5</code>, <code>02:00</code>, <code>01:30:00</code> o <code>90s</code> y luego pulsa Iniciar.
					</p>
				</div>
				<!-- Carte 3 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">03</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Añade tus tareas</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Usa el panel de Tareas para anotar en lo que estás trabajando. Las tareas pasan por los estados Pendiente, En curso y Completada.
					</p>
				</div>
				<!-- Carte 4 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">04</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Sigue tu tarea en curso</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Mantén hasta dos Tareas en curso simultáneamente. Cada una registra su propio tiempo de trabajo activo mientras una sesión de Temporizador o Cronómetro está en marcha.
					</p>
				</div>
				<!-- Carte 5 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">05</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Cambia la vista</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Alterna entre Moderno, Digital y Analógico, y elige Pequeño, Medio, Grande o Pantalla completa según el tamaño de visualización deseado.
					</p>
				</div>
				<!-- Carte 6 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">06</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Retoma donde lo dejaste</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						On Screen Timer guarda el estado de la sesión y tus preferencias localmente en el navegador, para que al recargar la página no pierdas tu trabajo.
					</p>
				</div>
			</div>

			<div class="flex justify-center sm:justify-start">
				<a href="/es/guide" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
				Leer la Guía completa
				<svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
				</a>
			</div>
		</section>

		<!-- Section FAQ aperçu -->
		<section id="faq-preview" class="w-full max-w-3xl mx-auto px-4 sm:px-6 py-12 lg:py-16 border-t border-zinc-200 dark:border-zinc-800 group-data-[size=full]/body:hidden">
			<h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-8 text-center sm:text-left">Preguntas frecuentes</h2>

			<div class="space-y-3 mb-10">
				<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
					<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
					¿Cómo configuro un temporizador online?
					<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</summary>
					<div class="p-4 pt-0 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed space-y-2">
						<p>Primero asegúrate de tener seleccionado el modo Temporizador. Introduce la duración deseada en el campo usando formatos como <code>5</code>, <code>02:00</code> o <code>01:30:00</code>. Luego pulsa Iniciar.</p>
					</div>
				</details>

				<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
					<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
					¿Necesito una cuenta para usar On Screen Timer?
					<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</summary>
					<div class="p-4 pt-0 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed space-y-2">
						<p>No se requiere cuenta para el uso normal. Está listo para usar de inmediato, sin necesidad de registrarse.</p>
					</div>
				</details>

				<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
					<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
					¿Qué sucede si recargo la página?
					<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</summary>
					<div class="p-4 pt-0 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed space-y-2">
						<p>Tu Temporizador, Cronómetro, tareas, preferencias y el estado del Bloque de estudio pueden restaurarse al volver o recargar la página, ya que se guardan localmente en tu navegador.</p>
					</div>
				</details>

				<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
					<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
					¿Qué es el modo de Pantalla completa?
					<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</summary>
					<div class="p-4 pt-0 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed space-y-2">
						<p>El modo de Pantalla completa proporciona una vista enfocada de la aplicación, ocultando los elementos no esenciales de la página mientras mantiene accesibles los controles importantes. No es la API de pantalla completa del navegador.</p>
					</div>
				</details>

				<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
					<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
					¿Cómo funcionan los Bloques de estudio?
					<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</summary>
					<div class="p-4 pt-0 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed space-y-2">
						<p>Elige una plantilla en la Configuración. El Temporizador utilizará fases nombradas (independientes de tu Tarea en curso) y avanzará automáticamente a través de cada segmento hasta finalizar el último.</p>
					</div>
				</details>

				<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
					<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
					¿Puedo usar On Screen Timer como temporizador Pomodoro?
					<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</summary>
					<div class="p-4 pt-0 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed space-y-2">
						<p>Sí, puedes usarlo manualmente para sesiones estilo Pomodoro (por ejemplo, 25 minutos de trabajo, breve descanso) configurando el temporizador, o utilizar los Bloques de estudio para seguir secuencias estructuradas.</p>
					</div>
				</details>
			</div>

			<div class="flex justify-center sm:justify-start">
				<a href="/es/faq" class="inline-flex items-center gap-2 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm px-1 py-0.5">
				Ver todas las preguntas frecuentes
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
				</a>
			</div>
		</section>
		<SiteFooter />

		<!-- Burger Menu Overlay -->
		<div id="burger-menu-overlay" class="hidden fixed inset-0 bg-black/20 dark:bg-black/40 z-40 transition-opacity opacity-0 group-data-[size=full]/body:hidden"></div>

		<!-- Burger Menu Panel -->
		<div id="burger-menu-panel" class="fixed right-0 top-0 bottom-0 w-64 bg-white dark:bg-zinc-900 border-l border-zinc-200 dark:border-zinc-800 shadow-xl z-50 transform translate-x-full transition-transform duration-300 group-data-[size=full]/body:hidden flex flex-col">
			<div class="h-14 flex items-center justify-between px-4 border-b border-zinc-200 dark:border-zinc-800">
				<span class="font-medium text-zinc-900 dark:text-zinc-100 text-sm">{t('menu.settings')}</span>
				<button type="button" id="btn-close-menu" class="p-1 text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
			</div>
			<div class="p-4 flex-1 overflow-y-auto">
				<div class="mb-6">
					<h3 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-3">Formato del reloj</h3>
					<div class="flex items-center gap-2">
						<button type="button" id="btn-clock-12h" class="flex-1 py-1.5 text-sm rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors font-medium">12 horas</button>
						<button type="button" id="btn-clock-24h" class="flex-1 py-1.5 text-sm rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors font-medium">24 horas</button>
					</div>
				</div>
				<div class="mb-6">
					<button type="button" aria-expanded="false" aria-controls="sound-chooser-container" class="sound-disclosure-btn flex items-center justify-between w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm group mb-3">
						<span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider pointer-events-none">{t('menu.sound')}</span>
						<svg class="w-4 h-4 text-zinc-400 group-aria-expanded:rotate-180 transition-transform pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</button>
					<div class="hidden flex-col gap-3" id="sound-chooser-container">
						<div class="flex items-center gap-3">
							<input type="range" id="volume-slider" min="0" max="100" step="1" value="1" aria-label={t('menu.volume')} class="w-full h-1.5 bg-zinc-200 dark:bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:accent-blue-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" />
							<span id="volume-display" aria-hidden="true" class="text-xs font-medium text-zinc-500 dark:text-zinc-400 w-8 text-right tabular-nums">1%</span>
						</div>
					</div>
				</div>
				<div class="mb-6">
					<button type="button" aria-expanded="false" aria-controls="preset-chooser-container" class="preset-disclosure-btn flex items-center justify-between w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm group mb-3">
						<span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider pointer-events-none">Plantillas de bloques de estudio</span>
						<svg class="w-4 h-4 text-zinc-400 group-aria-expanded:rotate-180 transition-transform pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</button>
					<div class="hidden flex-col gap-2" id="preset-chooser-container">
						<!-- Injected via workspace-controller -->
					</div>
				</div>
			</div>
		</div>

</Layout>

<script>
	import { initWorkspaceController } from '../../lib/workspace-controller';

	// Foundational Theme Switcher Controller
	const themeBtn = document.getElementById('btn-theme');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('ost_theme', isDark ? 'dark' : 'light');
			} catch {
				// Ignore quota/storage access errors
			}
		});
	}

	// Initialize Workspace Controller
	initWorkspaceController();
</script>
