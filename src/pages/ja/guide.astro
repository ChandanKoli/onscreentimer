---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Layout title="On Screen Timer ガイド — タイマー、タスク、学習ブロック" description="On Screen Timerを効果的に活用するための実践的な解説です。">
	<div class="min-h-dvh flex flex-col">
		<!-- Header -->
		<SiteHeader />

		<!-- Hub Content -->
		<main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-zinc-800 dark:text-zinc-200">
			<!-- Introductory Hero -->
			<div class="mb-16 sm:mb-20">
				<h1 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-zinc-950 dark:text-zinc-50 tracking-tight leading-[1.15] mb-4">
					ガイド
				</h1>
				<p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
					On Screen Timerを効果的に活用し、タイマー、タスク、学習ブロック、および表示コントロールをさらに使いこなすための実践的な解説です。
				</p>
			</div>

			<!-- Guides List -->
			<div class="space-y-12 sm:space-y-16">
				
				<!-- Guide: はじめに -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/ja/guide/getting-started" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							On Screen Timer はじめに
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						タイマー、時計、ストップウォッチの基本と主な操作方法を学びます。
					</p>
					<a href="/ja/guide/getting-started" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						ガイドを読む &rarr;
					</a>
				</article>

				<!-- Guide: Timer Inputs & Controls -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/ja/guide/timer-inputs-and-controls" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							タイマーの入力と操作
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						時間の入力方法とタイマーの操作について。
					</p>
					<a href="/ja/guide/timer-inputs-and-controls" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						ガイドを読む &rarr;
					</a>
				</article>

				<!-- Guide: Mini To-do & Current Task Timing -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/ja/guide/tasks" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							ミニToDoと実行中タスクの時間計測
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						「保留」「実行中」「完了」タスクとタイマーの連動について。
					</p>
					<a href="/ja/guide/tasks" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						ガイドを読む &rarr;
					</a>
				</article>

				<!-- Guide: 学習ブロックのプリセット -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/ja/guide/study-block-presets" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							学習ブロックのプリセット
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						タイマーを複数のフェーズに分割する学習ブロックについて。
					</p>
					<a href="/ja/guide/study-block-presets" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						ガイドを読む &rarr;
					</a>
				</article>

				<!-- Guide: Display Styles, Sizes & Full Mode -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/ja/guide/display-modes" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							表示スタイル、サイズ、全画面モード
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						見た目の変更、サイズの調整、アプリに集中できる全画面モードについて。
					</p>
					<a href="/ja/guide/display-modes" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						ガイドを読む &rarr;
					</a>
				</article>

				<!-- Guide: セッションの保存 -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/ja/guide/saving-your-session" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							セッションの保存
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						設定や実行中のタスクをブラウザにローカル保存する仕組みについて。
					</p>
					<a href="/ja/guide/saving-your-session" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						ガイドを読む &rarr;
					</a>
				</article>

				<!-- Guide: Keyboard, Sound & Settings -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/ja/guide/controls-and-settings" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							キーボード、音声、設定
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						便利なキーボードショートカット、音声設定、その他の設定について。
					</p>
					<a href="/ja/guide/controls-and-settings" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						ガイドを読む &rarr;
					</a>
				</article>

				<!-- Guide: Using On Screen Timer for Study & Focus -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/ja/guide/study-and-focus" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							学習と集中にOn Screen Timerを活用する
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						タイマー、タスク、プリセットを活用して学習に集中するためのヒント。
					</p>
					<a href="/ja/guide/study-and-focus" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						ガイドを読む &rarr;
					</a>
				</article>

			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>

<script>
	// Theme Switcher
	const themeBtn = document.getElementById('btn-theme');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('ost_theme', isDark ? 'dark' : 'light');
			} catch {
				// Ignore quota/storage access errors
			}
		});
	}
</script>
