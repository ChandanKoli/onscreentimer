---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

interface FAQItem {
	question: string;
	answer: string;
}

const faqs: FAQItem[] = [
	{
		question: "オンラインタイマーの設定方法は？",
		answer: "まず、上部ツールバーでタイマーモードが選択されていることを確認します。入力フィールドに<code>5</code>、<code>02:00</code>、<code>25m</code>、または<code>01:30:00</code>などの形式で希望する時間を入力し、スタートをクリックするかスペースキーを押します。"
	},
	{
		question: "On Screen Timerを使うにはアカウントが必要ですか？",
		answer: "通常の使用にアカウントや登録は一切不要です。課金やサインアップ、ユーザー追跡なしで、ページを開いてすぐ完全無料でご利用いただけます。"
	},
	{
		question: "ページを再読み込みしたりブラウザを閉じるとどうなりますか？",
		answer: "実行中のタイマー、ストップウォッチのラップ記録、やることリスト、カスタム学習ブロック、アラーム音設定、テーマ設定はお使いのブラウザの<code>localStorage</code>に自動保存され、次回アクセス時に自動で復元されます。"
	},
	{
		question: "フルモードとは何ですか？",
		answer: "フルモードは不要なヘッダーや操作枠を隠し、大画面で見やすい時間表示に集中できる機能です。キーボードの<code>F</code>キーを押すことで全画面表示を切り替えられます。"
	},
	{
		question: "学習ブロック（Study Blocks）プリセットはどのように機能しますか？",
		answer: "設定から定番のポモドーロ（25/5）や50/10などのプリセットを選択します。タイマーが作業時間と休憩時間を自動で切り替え、フェーズの切り替わり時にチャイム音で通知します。"
	},
	{
		question: "On Screen Timerをポモドーロタイマーとして利用できますか？",
		answer: "はい。手動で25分の作業と5分の休憩を設定することもできますし、設定メニューにある内蔵のポモドーロプリセットを使って自動サイクルを実行することも可能です。"
	},
	{
		question: "画面スリープ防止（Screen Wake Lock）はカウントダウン中にどのように動作しますか？",
		answer: "On Screen Timerはブラウザ標準の Screen Wake Lock API を使用し、タイマーやストップウォッチの計測中に画面が暗くなったりスリープ状態に入ったりするのを自動で防止します。タイマー開始時に自動で有効化され、一時停止や終了時に解除されます。プレゼンテーション、試験、料理、筋トレ中も画面を常に点灯させ続けることができます（ブラウザタブを表示したままにしてください）。"
	},
	{
		question: "プレゼンテーションや試験で使えるキーボードショートカットや全画面表示はありますか？",
		answer: "直感的なショートカットキーで素早く操作できます：<code>スペースキー</code>で開始・一時停止、<code>R</code>キーでリセット、<code>F</code>キーで全画面／集中表示を切り替えます。フルモードでは不要なヘッダーや操作パネルが最小化され、教室や会議室の離れた場所からでも一目で時間が読み取れる大画面表示になります。"
	},
	{
		question: "ブラウザのローカル保存機能によってタスクリストやラップタイムのプライバシーはどのように保護されますか？",
		answer: "やることリスト、完了タスク数、カスタム学習ブロック、アラーム音設定、ストップウォッチのラップ記録などのすべてのデータは、お使いのブラウザのローカルストレージ（<code>localStorage</code>）にのみ保存されます。データが外部サーバーやクラウドに送信されることは一切なく、完全なプライバシーとオフラインでの動作が保証されます。"
	},
	{
		question: "ポモドーロ（25分/5分）や 50/10 インターバルを集中学習に活用するには？",
		answer: "50/10 テクニックは50分間の深い集中と10分間の休憩を繰り返す手法で、長時間の学問や知的作業に最適です。設定メニューからポモドーロ（25/5）または 50/10 プリセットを選択すると、作業フェーズと休憩フェーズが自動で切り替わり、節目ごとにチャイム音で知らせてくれます。"
	},
	{
		question: "バックグラウンドのタブでタイマーのアラーム音が鳴らなかったのはなぜですか？",
		answer: "最近のウェブブラウザは、バックグラウンドタブでの予期せぬ音声再生を制限する自動再生ポリシーを備えています。確実に音を鳴らすには：1) ページを開いた後に画面をクリックするかキーを押して音声再生権限をブラウザに付与してください。2) タブのミュート（消音）アイコンがオンになっていないか確認してください。3) 端末の音量設定やマナーモードのスイッチを確認してください。"
	},
	{
		question: "カウントダウンタイマー、デジタル時計、ラップ機能付きストップウォッチの違いは何ですか？",
		answer: "On Screen Timerは3つの時間計測ツールを1つに統合しています：1) <strong>カウントダウンタイマー:</strong> 設定した時間からゼロまで減算し、終了時にアラーム音で知らせます（料理、プレゼン、試験に最適）；2) <strong>デジタル時計:</strong> 現在の正確な現地時刻を秒単位（12時間／24時間表示）で表示します；3) <strong>ラップストップウォッチ:</strong> ミリ秒単位で時間を加算計測し、スプリットタイムや個別ラップを記録できるテーブルを備えています（スポーツ、トレーニング、作業速度の測定に最適）。"
	}
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqs.map((faq) => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.answer.replace(/<[^>]*>?/gm, '')
		}
	}))
};
---

<Layout title="よくある質問 — On Screen Timer" description="On Screen Timerに関するよくある質問。オンラインタイマーの使い方、タスク管理、全画面モード、画面スリープ防止、セッションの保存など。">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	</Fragment>
	<div class="min-h-dvh flex flex-col justify-between">
		<SiteHeader />
		<main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
			<h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 mb-8">よくある質問</h1>
			
			<div class="space-y-4">
				{faqs.map((faq, index) => (
					<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900" open={index === 0}>
						<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
							{faq.question}
							<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
						</summary>
						<div class="p-4 pt-0 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed space-y-2">
							<p set:html={faq.answer} />
						</div>
					</details>
				))}
			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>
