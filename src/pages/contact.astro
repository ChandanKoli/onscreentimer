---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="Contact — On Screen Timer" description="Contact On Screen Timer for questions, bug reports, and feedback.">
	<div class="min-h-dvh flex flex-col">
		<SiteHeader />

		<main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-zinc-800 dark:text-zinc-200">
			<div class="mb-12">
				<h1 class="text-3xl sm:text-4xl font-bold text-zinc-950 dark:text-zinc-50 tracking-tight mb-4">
					Contact
				</h1>
			</div>

			<div class="space-y-8">
				<p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
					Questions, corrections, bug reports, and general feedback about On Screen Timer are welcome.
				</p>

				<div class="p-6 sm:p-8 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col items-start gap-2">
					<h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">Email</h2>
					<a href="mailto:contact@onscreentimer.com" class="text-xl sm:text-2xl font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						contact@onscreentimer.com
					</a>
				</div>
				
				<p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-2xl mt-8">
					Feel free to reach out regarding bugs, incorrect Guide/FAQ information, accessibility issues, or general feedback.
				</p>
			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>
