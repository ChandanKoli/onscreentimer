---
import Layout from '../../../layouts/Layout.astro';
import { getLocaleFromUrl } from '../../../i18n/utils.ts';
import { useTranslations } from '../../../i18n/ui.ts';
import TimerWorkspace from '../../../components/TimerWorkspace.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';

export function getStaticPaths() {
	return [
		{ params: { duration: '1-minute' }, props: { seconds: 60, minutes: 1 } },
		{ params: { duration: '5-minutes' }, props: { seconds: 300, minutes: 5 } },
		{ params: { duration: '10-minutes' }, props: { seconds: 600, minutes: 10 } },
		{ params: { duration: '15-minutes' }, props: { seconds: 900, minutes: 15 } },
		{ params: { duration: '20-minutes' }, props: { seconds: 1200, minutes: 20 } },
		{ params: { duration: '25-minutes' }, props: { seconds: 1500, minutes: 25 } },
		{ params: { duration: '30-minutes' }, props: { seconds: 1800, minutes: 30 } },
		{ params: { duration: '60-minutes' }, props: { seconds: 3600, minutes: 60 } },
	];
}

const { duration } = Astro.params;
const { seconds, minutes } = Astro.props;

const title = `Timer ${minutes} minut${minutes === 1 ? 'o' : 'i'} — On Screen Timer`;
const description = `Timer online gratuito da ${minutes} minut${minutes === 1 ? 'o' : 'i'}. Funziona direttamente nel tuo browser.`;

let content = [];
if (minutes === 1) {
	content = [
		"Un timer da 1 minuto può essere utile per azioni molto brevi, un controllo veloce o un reset rapido.",
		"Premendo Avvia, il timer effettua un conto alla rovescia da 1 minuto. Ti avviserà quando raggiunge lo zero."
	];
} else if (minutes === 5) {
	content = [
		"Un timer da 5 minuti è utile per un ripasso veloce, una breve pausa o una piccola attività a tempo.",
		"Premendo Avvia, il timer effettua un conto alla rovescia da 5 minuti. Puoi anche usare l'elenco delle Attività per tenere traccia del tuo lavoro."
	];
} else if (minutes === 10) {
	content = [
		"Un timer da 10 minuti è un'ottima opzione per un breve sprint di concentrazione, una sessione di revisione o una prova di presentazione.",
		"Premendo Avvia, il timer effettua un conto alla rovescia da 10 minuti. Sentiti libero di ridurre a icona l'elenco delle Attività per un'esperienza con meno distrazioni."
	];
} else if (minutes === 15) {
	content = [
		"Un timer da 15 minuti può essere adatto per un ripasso mirato o un blocco di lettura e pratica.",
		"Premendo Avvia, il timer effettua un conto alla rovescia da 15 minuti. Ti avviserà quando raggiunge lo zero."
	];
} else if (minutes === 20) {
	content = [
		"Un timer da 20 minuti può essere utile per un breve sprint di studio o lavoro, oppure una sessione di lettura e pratica.",
		"Premendo Avvia, il timer effettua un conto alla rovescia da 20 minuti."
	];
} else if (minutes === 25) {
	content = [
		"Un timer da 25 minuti è una durata comune per i blocchi di focus in stile Pomodoro.",
		"Premendo Avvia, il timer effettua un conto alla rovescia da 25 minuti. Nota che On Screen Timer non avvia automaticamente una pausa Pomodoro al termine di questo timer, a meno che non la configuri tramite i preset dei Blocchi di Studio."
	];
} else if (minutes === 30) {
	content = [
		"Un timer da 30 minuti è utile per una sessione di studio, lavoro o pratica di mezz'ora.",
		"Premendo Avvia, il timer effettua un conto alla rovescia da 30 minuti. Puoi usare l'elenco delle Attività per annotare cosa vuoi completare in questa mezz'ora."
	];
} else if (minutes === 60) {
	content = [
		"Un timer da 60 minuti (1 ora) può essere utile per una sessione di studio o di lavoro prolungata.",
		"Premendo Avvia, il timer da un'ora effettuerà il conto alla rovescia. Se hai bisogno di una sessione più strutturata con pause integrate, consulta la guida Studio e Concentrazione o i preset dei Blocchi di Studio nelle impostazioni."
	];
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---
<Layout title={title} description={description}>
	<div class="min-h-dvh flex flex-col justify-between">
		<!-- Header -->
		<SiteHeader />

		<!-- Main Workspace Foundation -->
		<main id="tool" class="scroll-mt-28 flex-1 lg:min-h-[calc(100dvh-3.5rem)] max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 lg:py-12 flex flex-col lg:flex-row items-center justify-center gap-6 lg:gap-12 group-data-[size=full]/body:items-center">

			<!-- Reopen Button (Desktop Minimized State) -->
			<button type="button" id="btn-desktop-todo-reopen" class="hidden fixed left-0 top-1/2 -translate-y-1/2 w-6 h-16 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 border-l-0 rounded-r-md shadow-sm items-center justify-center text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400 group-data-[size=full]/body:!hidden transition-colors z-40" aria-label={t("aria.reopenTodo")} title={t("tasks.todo")}>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
			</button>

			<!-- Central Time Workspace -->
			<div class="flex-1 flex flex-col items-center justify-center w-full min-w-0 order-1 lg:order-2">
				<TimerWorkspace />
			</div>

			<!-- Mini To-do Panel (Left on Desktop, stacked below on Mobile) -->
			<aside id="todo-panel" class="w-full max-w-md lg:w-72 lg:max-w-none flex flex-col border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900 shadow-sm p-4 shrink-0 order-2 lg:order-1 group-data-[size=full]/body:hidden transition-all overflow-hidden lg:overflow-visible">
				<!-- Mobile Toggle -->
				<button type="button" id="btn-mobile-todo-toggle" aria-expanded="false" aria-controls="todo-content" class="lg:hidden flex items-center justify-between w-full text-left font-medium text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
					<span class="text-sm">Attività <span id="todo-mobile-count" class="text-zinc-500 font-normal ml-2"></span></span>
					<svg id="todo-mobile-chevron" class="w-5 h-5 text-zinc-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
				</button>

				<!-- Desktop Header -->
				<div class="hidden lg:flex items-center justify-between mb-4">
					<h2 class="text-sm font-medium text-zinc-900 dark:text-zinc-100 text-left">
						Attività
					</h2>
					<button type="button" id="btn-desktop-todo-minimize" class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400 rounded p-0.5" aria-label={t("aria.minimizeTodo")} title={t("aria.minimize")}>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
					</button>
				</div>

				<!-- Expandable Content -->
				<div id="todo-content" class="hidden lg:flex flex-col mt-4 lg:mt-0">
					<form id="todo-form" class="relative flex items-center mb-4">
						<input type="text" id="todo-input" placeholder={t("tasks.addPlaceholder")} class="w-full h-9 px-3 pr-9 text-sm rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 transition-colors" autocomplete="off" />
						<button type="submit" class="absolute right-1 w-7 h-7 flex items-center justify-center text-zinc-500 hover:text-blue-600 dark:hover:text-blue-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded" aria-label={t("aria.addTask")}>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
						</button>
					</form>
					<div id="todo-list" class="flex flex-col gap-2 overflow-y-auto max-h-[50vh] text-left">
						<!-- Tasks will be rendered here -->
					</div>
					<!-- Task Summary -->
					<div id="todo-summary" class="hidden mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800/80 text-[11px] text-zinc-500 dark:text-zinc-400 font-medium text-center">
						Completate <span id="count-done">0</span> &middot; Rimanenti <span id="count-remaining">0</span>
					</div>
				</div>
			</aside>
		</main>

		<!-- Content Section -->
		<section class="w-full max-w-3xl mx-auto px-4 sm:px-6 py-12 lg:py-16 border-t border-zinc-200 dark:border-zinc-800 group-data-[size=full]/body:hidden">
			<h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6">Timer {minutes} minut{minutes === 1 ? 'o' : 'i'}</h1>

			<div class="prose prose-zinc dark:prose-invert text-zinc-600 dark:text-zinc-400">
				{content.map((paragraph) => (
					<p class="mb-4">{paragraph}</p>
				))}

				<h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mt-8 mb-4">Usi comuni</h2>
				<p>Questo timer può essere utilizzato con l'elenco delle Attività integrato per aiutarti a rimanere concentrato sull'attività attuale senza distrazioni.</p>

				<h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mt-8 mb-4">Domande frequenti</h2>
				<div class="space-y-4">
					<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
						<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
						Come avviare il timer da {minutes} minut{minutes === 1 ? 'o' : 'i'}?
						<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
						</summary>
						<div class="p-4 pt-0 text-sm leading-relaxed space-y-2 text-zinc-600 dark:text-zinc-400">
							<p>Basta premere il pulsante Avvia nel timer qui sopra. È già impostato per {minutes} minut{minutes === 1 ? 'o' : 'i'}.</p>
						</div>
					</details>
					<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
						<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
						Cosa succede quando raggiunge lo zero?
						<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
						</summary>
						<div class="p-4 pt-0 text-sm leading-relaxed space-y-2 text-zinc-600 dark:text-zinc-400">
							<p>Il timer ti avviserà con un suono (se abilitato) e un indicatore visivo quando il tempo è scaduto.</p>
						</div>
					</details>
					<details class="group border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900">
						<summary class="flex items-center justify-between cursor-pointer p-4 font-medium text-sm text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl">
						Posso mettere in pausa e riprendere?
						<svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
						</summary>
						<div class="p-4 pt-0 text-sm leading-relaxed space-y-2 text-zinc-600 dark:text-zinc-400">
							<p>Sì, puoi mettere in pausa il timer in qualsiasi momento e riprenderlo quando sei pronto.</p>
						</div>
					</details>
				</div>

				<p class="mt-8">
					<a href="/it/" class="text-blue-600 dark:text-blue-400 hover:underline">Imposta una durata diversa &rarr;</a>
				</p>
			</div>
		</section>

		<SiteFooter />

		<!-- Burger Menu Overlay -->
		<div id="burger-menu-overlay" class="hidden fixed inset-0 bg-black/20 dark:bg-black/40 z-40 transition-opacity opacity-0 group-data-[size=full]/body:hidden"></div>

		<!-- Burger Menu Panel -->
		<div id="burger-menu-panel" class="fixed right-0 top-0 bottom-0 w-64 bg-white dark:bg-zinc-900 border-l border-zinc-200 dark:border-zinc-800 shadow-xl z-50 transform translate-x-full transition-transform duration-300 group-data-[size=full]/body:hidden flex flex-col">
			<div class="h-14 flex items-center justify-between px-4 border-b border-zinc-200 dark:border-zinc-800">
				<span class="font-medium text-zinc-900 dark:text-zinc-100 text-sm">{t('menu.settings')}</span>
				<button type="button" id="btn-close-menu" class="p-1 text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
			</div>
			<div class="p-4 flex-1 overflow-y-auto">
				<div class="mb-6">
					<h3 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-3">Formato orologio</h3>
					<div class="flex items-center gap-2">
						<button type="button" id="btn-clock-12h" class="flex-1 py-1.5 text-sm rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors font-medium">12 ore</button>
						<button type="button" id="btn-clock-24h" class="flex-1 py-1.5 text-sm rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors font-medium">24 ore</button>
					</div>
				</div>
				<div class="mb-6">
					<button type="button" aria-expanded="false" aria-controls="preset-chooser-container" class="preset-disclosure-btn flex items-center justify-between w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm group mb-3">
						<span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider pointer-events-none">Preset dei Blocchi di Studio</span>
						<svg class="w-4 h-4 text-zinc-400 group-aria-expanded:rotate-180 transition-transform pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
					</button>
					<div class="hidden flex-col gap-2" id="preset-chooser-container">
						<!-- Injected via workspace-controller -->
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script define:vars={{ overrideTimerDuration: seconds }}>
	// This script block injects the override variable into the global scope
	// so the module script below can access it.
	window.OST_OVERRIDE_DURATION = overrideTimerDuration;
</script>

<script>
	import { initWorkspaceController } from '../../../lib/workspace-controller';

	// Foundational Theme Switcher Controller
	const themeBtn = document.getElementById('btn-theme');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('ost_theme', isDark ? 'dark' : 'light');
			} catch {
				// Ignore quota/storage access errors
			}
		});
	}

	// Initialize Workspace Controller with override from window
	const win = window as any;
	initWorkspaceController({ overrideTimerDuration: win.OST_OVERRIDE_DURATION });
</script>
