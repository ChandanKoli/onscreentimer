---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Layout title="Kontakt — On Screen Timer" description="Kontaktiere On Screen Timer">
	<div class="min-h-dvh flex flex-col">
		<SiteHeader />

		<main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-zinc-800 dark:text-zinc-200">
			<div class="mb-12">
				<h1 class="text-3xl sm:text-4xl font-bold text-zinc-950 dark:text-zinc-50 tracking-tight mb-4">
					Kontakt
				</h1>
			</div>

			<article class="prose prose-zinc dark:prose-invert prose-blue max-w-none space-y-8">
				<section>
					<h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-3">Kontakt aufnehmen</h2>
					<p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Wenn du Fragen hast, Feedback geben möchtest oder Hilfe bei der Nutzung von On Screen Timer benötigst, kannst du uns per E-Mail kontaktieren:
					</p>
					<p class="text-zinc-600 dark:text-zinc-400 leading-relaxed font-medium mt-4">
						<a href="mailto:contact@example.com" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 underline underline-offset-4">
							contact@example.com
						</a>
					</p>
				</section>
			</article>
		</main>
		<SiteFooter />
	</div>
</Layout>
