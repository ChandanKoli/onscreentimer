---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Layout title="Guia do On Screen Timers — Timer, Tasks & Study Blocks" description="Practical explanations for using On Screen Timer effectively.">
	<div class="min-h-dvh flex flex-col">
		<!-- Header -->
		<SiteHeader />

		<!-- Hub Content -->
		<main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-zinc-800 dark:text-zinc-200">
			<!-- Introductory Hero -->
			<div class="mb-16 sm:mb-20">
				<h1 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-zinc-950 dark:text-zinc-50 tracking-tight leading-[1.15] mb-4">
					Guides
				</h1>
				<p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
					Practical explanations for using On Screen Timer and getting more from its timer, tasks, study blocks, and display controls.
				</p>
			</div>

			<!-- Guides List -->
			<div class="space-y-12 sm:space-y-16">
				
				<!-- Guide: Começando -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/pt-br/guide/getting-started" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Começando with On Screen Timer
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Aprenda o básico do Temporizador, Relógio, Cronômetro e os controles principais.
					</p>
					<a href="/pt-br/guide/getting-started" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Ler guia &rarr;
					</a>
				</article>

				<!-- Guide: Timer Inputs & Controls -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/pt-br/guide/timer-inputs-and-controls" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Entradas e Controles do Temporizador
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Aprenda como inserir durações e controlar a contagem regressiva ativa do Temporizador.
					</p>
					<a href="/pt-br/guide/timer-inputs-and-controls" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Ler guia &rarr;
					</a>
				</article>

				<!-- Guide: Mini To-do & Current Task Timing -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/pt-br/guide/tasks" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Tarefas e Cronometragem da Tarefa Atual
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Aprenda como as tarefas Pendentes, Atuais e Concluídas funcionam junto com o seu temporizador.
					</p>
					<a href="/pt-br/guide/tasks" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Ler guia &rarr;
					</a>
				</article>

				<!-- Guide: Modelos de Bloco de Estudo -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/pt-br/guide/study-block-presets" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Modelos de Bloco de Estudo
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Aprenda como as sequências de estudo predefinidas do On Screen Timer dividem uma sessão do Temporizador em fases nomeadas.
					</p>
					<a href="/pt-br/guide/study-block-presets" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Ler guia &rarr;
					</a>
				</article>

				<!-- Guide: Estilos, Tamanhos de Exibição e Modo Tela cheia -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/pt-br/guide/display-modes" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Estilos, Tamanhos de Exibição e Modo Tela cheia
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Aprenda sobre estilos visuais, redimensionamento do temporizador e a utilização do modo focado de Tela cheia.
					</p>
					<a href="/pt-br/guide/display-modes" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Ler guia &rarr;
					</a>
				</article>

				<!-- Guide: Salvando Sua Sessão -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/pt-br/guide/saving-your-session" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Salvando Sua Sessão
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Aprenda como o On Screen Timer salva suas preferências e tarefas ativas localmente no seu navegador.
					</p>
					<a href="/pt-br/guide/saving-your-session" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Ler guia &rarr;
					</a>
				</article>

				<!-- Guide: Keyboard, Sound & Settings -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/pt-br/guide/controls-and-settings" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Teclado, Som e Configurações
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Aprenda sobre atalhos de teclado úteis, configurações de áudio e preferências gerais.
					</p>
					<a href="/pt-br/guide/controls-and-settings" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Ler guia &rarr;
					</a>
				</article>

				<!-- Guide: Using On Screen Timer for Study & Focus -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/pt-br/guide/study-and-focus" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Usando o On Screen Timer para Estudo e Foco
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Dicas práticas sobre o uso do temporizador, tarefas e modelos para sessões de estudo focadas.
					</p>
					<a href="/pt-br/guide/study-and-focus" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Ler guia &rarr;
					</a>
				</article>

			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>

<script>
	// Theme Switcher
	const themeBtn = document.getElementById('btn-theme');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('ost_theme', isDark ? 'dark' : 'light');
			} catch {
				// Ignore quota/storage access errors
			}
		});
	}
</script>
