---
import Layout from '../layouts/Layout.astro';
import TimerWorkspace from '../components/TimerWorkspace.astro';
---

<Layout>
	<div class="min-h-dvh flex flex-col justify-between">
		<!-- Header -->
		<header id="site-header" class="w-full border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 group-data-[size=full]/body:hidden">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
				<!-- Brand / Home and Nav -->
				<div class="flex items-center gap-6">
					<a
						href="/"
						class="flex items-center gap-2 text-zinc-950 dark:text-zinc-50 font-semibold tracking-tight hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none rounded-sm px-1 py-0.5"
						aria-label="OnScreenTimer Home"
					>
						<span class="w-2.5 h-2.5 rounded-full bg-blue-600 dark:bg-blue-500" aria-hidden="true"></span>
						<span class="text-base font-medium">OnScreenTimer</span>
					</a>
					<nav>
						<a href="/guide" class="text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm px-1 py-0.5">Guide</a>
					</nav>
				</div>

				<!-- Header Controls -->
				<div class="flex items-center gap-2 sm:gap-3">
					<!-- Sound / Mute Toggle Button -->
					<button
						type="button"
						id="btn-sound"
						class="w-8 h-8 rounded-full border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none"
						aria-label="Sound enabled"
						title="Sound enabled"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
						</svg>
					</button>

					<!-- Language Selector -->
					<button
						type="button"
						id="btn-language"
						class="h-8 px-2.5 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none flex items-center gap-1"
						aria-label="Language: English"
					>
						<span>English</span>
						<svg class="w-3 h-3 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
						</svg>
					</button>

					<!-- Theme Toggle Button -->
					<button
						type="button"
						id="btn-theme"
						class="w-8 h-8 rounded-full border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none"
						aria-label="Toggle theme"
						title="Toggle theme"
					>
						<!-- Sun icon (shown in dark mode) -->
						<svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
						</svg>
						<!-- Moon icon (shown in light mode) -->
						<svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
						</svg>
					</button>

					<!-- Menu Button -->
					<button
						type="button"
						id="btn-menu"
						class="w-8 h-8 rounded-md border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none"
						aria-label="Settings and menu"
						title="Menu"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
						</svg>
					</button>
				</div>
			</div>
		</header>

		<!-- Main Workspace Foundation -->
		<main id="app-workspace" class="flex-1 lg:min-h-[calc(100dvh-3.5rem)] max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 lg:py-12 flex flex-col lg:flex-row items-center justify-center gap-6 lg:gap-12 group-data-[size=full]/body:items-center">
			
			<!-- Reopen Button (Desktop Minimized State) -->
			<button type="button" id="btn-desktop-todo-reopen" class="hidden fixed left-0 top-1/2 -translate-y-1/2 w-6 h-16 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 border-l-0 rounded-r-md shadow-sm items-center justify-center text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400 group-data-[size=full]/body:!hidden transition-colors z-40" aria-label="Reopen To-do" title="To-do">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
			</button>

			<!-- Central Time Workspace -->
			<div class="flex-1 flex flex-col items-center justify-center w-full min-w-0 order-1 lg:order-2">
				<TimerWorkspace />
			</div>

			<!-- Mini To-do Panel (Left on Desktop, stacked below on Mobile) -->
			<aside id="todo-panel" class="w-full max-w-md lg:w-72 lg:max-w-none flex flex-col border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900 shadow-sm p-4 shrink-0 order-2 lg:order-1 group-data-[size=full]/body:hidden transition-all overflow-hidden lg:overflow-visible">
				<!-- Mobile Toggle -->
				<button type="button" id="btn-mobile-todo-toggle" aria-expanded="false" aria-controls="todo-content" class="lg:hidden flex items-center justify-between w-full text-left font-medium text-zinc-900 dark:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
					<span class="text-sm">To-do <span id="todo-mobile-count" class="text-zinc-500 font-normal ml-2"></span></span>
					<svg id="todo-mobile-chevron" class="w-5 h-5 text-zinc-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
				</button>
				
				<!-- Desktop Header -->
				<div class="hidden lg:flex items-center justify-between mb-4">
					<h2 class="text-sm font-medium text-zinc-900 dark:text-zinc-100 text-left">
						To-do
					</h2>
					<button type="button" id="btn-desktop-todo-minimize" class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400 rounded p-0.5" aria-label="Minimize To-do" title="Minimize">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
					</button>
				</div>
				
				<!-- Expandable Content -->
				<div id="todo-content" class="hidden lg:flex flex-col mt-4 lg:mt-0">
					<form id="todo-form" class="relative flex items-center mb-4">
						<input type="text" id="todo-input" placeholder="Add a task..." class="w-full h-9 px-3 pr-9 text-sm rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 transition-colors" autocomplete="off" />
						<button type="submit" class="absolute right-1 w-7 h-7 flex items-center justify-center text-zinc-500 hover:text-blue-600 dark:hover:text-blue-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded" aria-label="Add task">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
						</button>
					</form>
					<div id="todo-list" class="flex flex-col gap-2 overflow-y-auto max-h-[50vh] text-left">
						<!-- Tasks will be rendered here -->
					</div>
					<!-- Task Summary -->
					<div id="todo-summary" class="hidden mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800/80 text-[11px] text-zinc-500 dark:text-zinc-400 font-medium text-center">
						Done <span id="count-done">0</span> &middot; Remaining <span id="count-remaining">0</span>
					</div>
				</div>
			</aside>
		</main>

		<!-- How It Works Section -->
		<section id="how-it-works" class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-12 lg:py-16 border-t border-zinc-200 dark:border-zinc-800 group-data-[size=full]/body:hidden">
			<h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-8 text-center sm:text-left">How It Works</h2>
			
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
				<!-- Card 1 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">01</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Choose a mode</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Use Timer, Clock, or Stopwatch depending on whether you want to count down, see the current time, or measure elapsed time.
					</p>
				</div>
				<!-- Card 2 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">02</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Set and start</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Enter a duration such as <code>5</code>, <code>2mins</code>, <code>02:00</code>, <code>1hr 30mins</code>, or <code>90s</code> then press Start.
					</p>
				</div>
				<!-- Card 3 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">03</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Add your tasks</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Use the Mini To-do to add what you are working on. Tasks move through Pending, Current, and Completed.
					</p>
				</div>
				<!-- Card 4 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">04</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Track your current work</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Keep up to two Current Tasks at once. Each records its own active work duration while a Timer or Stopwatch session runs.
					</p>
				</div>
				<!-- Card 5 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">05</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Change the view</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						Switch between Modern, Digital, and Analog, and choose Tiny, Mid, Big, or Full depending on how large or focused you want the display.
					</p>
				</div>
				<!-- Card 6 -->
				<div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm flex flex-col">
					<div class="text-xs font-semibold text-blue-600 dark:text-blue-400 tracking-wider mb-2">06</div>
					<h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100 mb-3">Pick up where you left off</h3>
					<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
						OnScreenTimer stores supported session state and preferences locally in the browser so refreshing does not automatically erase your work.
					</p>
				</div>
			</div>

			<div class="flex justify-center sm:justify-start">
				<a href="/guide" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
					Read the full Guide
					<svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
				</a>
			</div>
		</section>

		<!-- Base Footer -->
		<footer id="site-footer" class="w-full border-t border-zinc-200 dark:border-zinc-800 py-6 text-center text-xs text-zinc-500 dark:text-zinc-400 group-data-[size=full]/body:hidden">
			<p>OnScreenTimer &mdash; Browser Utility</p>
		</footer>

		<!-- Burger Menu Overlay -->
		<div id="burger-menu-overlay" class="hidden fixed inset-0 bg-black/20 dark:bg-black/40 z-40 transition-opacity opacity-0 group-data-[size=full]/body:hidden"></div>
		
		<!-- Burger Menu Panel -->
		<div id="burger-menu-panel" class="fixed right-0 top-0 bottom-0 w-64 bg-white dark:bg-zinc-900 border-l border-zinc-200 dark:border-zinc-800 shadow-xl z-50 transform translate-x-full transition-transform duration-300 group-data-[size=full]/body:hidden flex flex-col">
			<div class="h-14 flex items-center justify-between px-4 border-b border-zinc-200 dark:border-zinc-800">
				<span class="font-medium text-zinc-900 dark:text-zinc-100 text-sm">Settings</span>
				<button type="button" id="btn-close-menu" class="p-1 text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
			</div>
			<div class="p-4 flex-1 overflow-y-auto">
				<div class="mb-6">
					<h3 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-3">Clock Format</h3>
					<div class="flex items-center gap-2">
						<button type="button" id="btn-clock-12h" class="flex-1 py-1.5 text-sm rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors font-medium">12-hour</button>
						<button type="button" id="btn-clock-24h" class="flex-1 py-1.5 text-sm rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors font-medium">24-hour</button>
					</div>
				</div>
				<div class="mb-6">
					<h3 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-3">Study Block Presets</h3>
					<div class="flex flex-col gap-2" id="preset-chooser-container">
						<!-- Injected via workspace-controller -->
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script>
	import { initWorkspaceController } from '../lib/workspace-controller';

	// Foundational Theme Switcher Controller
	const themeBtn = document.getElementById('btn-theme');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('ost_theme', isDark ? 'dark' : 'light');
			} catch {
				// Ignore quota/storage access errors
			}
		});
	}

	// Initialize Phase 3 Workspace Controller
	initWorkspaceController();
</script>

