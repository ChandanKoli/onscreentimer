---
import Layout from '../layouts/Layout.astro';
---

<Layout title="How to Use OnScreenTimer — Guide" description="Learn how to use OnScreenTimer, a distraction-free browser timer, clock, stopwatch, and task-timing utility.">
	<div class="min-h-dvh flex flex-col">
		<!-- Header -->
		<header id="site-header" class="w-full border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 sticky top-0 z-30">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
				<!-- Brand / Home and Nav -->
				<div class="flex items-center gap-6">
					<a
						href="/"
						class="flex items-center gap-2 text-zinc-950 dark:text-zinc-50 font-semibold tracking-tight hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none rounded-sm px-1 py-0.5"
						aria-label="OnScreenTimer Home"
					>
						<span class="w-2.5 h-2.5 rounded-full bg-blue-600 dark:bg-blue-500" aria-hidden="true"></span>
						<span class="text-base font-medium">OnScreenTimer</span>
					</a>
					<nav>
						<a href="/guide" class="text-sm font-medium text-blue-600 dark:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm px-1 py-0.5" aria-current="page">Guide</a>
					</nav>
				</div>

				<!-- Header Controls -->
				<div class="flex items-center gap-2 sm:gap-3">
					<!-- Theme Toggle Button -->
					<button
						type="button"
						id="btn-theme"
						class="w-8 h-8 rounded-full border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none"
						aria-label="Toggle theme"
						title="Toggle theme"
					>
						<!-- Sun icon (shown in dark mode) -->
						<svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
						</svg>
						<!-- Moon icon (shown in light mode) -->
						<svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
						</svg>
					</button>
				</div>
			</div>
		</header>

		<!-- Guide Content -->
		<main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 text-zinc-800 dark:text-zinc-200">
			<!-- Back Navigation Breadcrumb -->
			<div class="mb-6">
				<a
					href="/"
					class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
					</svg>
					Back to Timer
				</a>
			</div>

			<!-- Introductory Hero -->
			<div class="mb-10 sm:mb-12">
				<h1 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-zinc-950 dark:text-zinc-50 tracking-tight leading-[1.15] mb-4">
					How to Use OnScreenTimer
				</h1>
				<p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-3xl">
					Learn how to use the Timer, Clock, Stopwatch, Mini To-do, Study Block Presets, display modes, and saved browser state.
				</p>
				<p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2 leading-relaxed">
					OnScreenTimer is a lightweight utility designed to work directly in your browser. No account is required.
				</p>
			</div>

			<!-- On this page quick navigation -->
			<nav aria-label="On this page" class="flex flex-wrap items-center gap-1.5 pb-8 mb-12 border-b border-zinc-200 dark:border-zinc-800">
				<span class="text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mr-1.5">Jump to:</span>
				<a href="#timer" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Timer</a>
				<a href="#clock" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Clock</a>
				<a href="#stopwatch" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Stopwatch</a>
				<a href="#todo" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">To-do</a>
				<a href="#task-timing" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Task Timing</a>
				<a href="#presets" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Study Presets</a>
				<a href="#display-styles" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Display Styles</a>
				<a href="#display-sizes" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Display Sizes</a>
				<a href="#sound" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Sound</a>
				<a href="#keyboard" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Keyboard</a>
				<a href="#saving" class="px-2.5 py-1 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors">Saving</a>
			</nav>

			<div class="space-y-12 sm:space-y-16">
				<!-- Timer Section -->
				<section id="timer" class="scroll-mt-20 space-y-4">
					<h2 class="text-2xl sm:text-[1.65rem] font-semibold text-zinc-950 dark:text-zinc-50 tracking-tight">Timer</h2>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Timer counts down from a duration selected by the user. You can enter durations using standard digits or natural time expressions.
					</p>

					<!-- Supported Duration Formats -->
					<div class="p-4 rounded-xl bg-zinc-50/90 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 my-4">
						<div class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2.5">Supported Duration Formats</div>
						<div class="flex flex-wrap items-center gap-2">
							<span class="inline-flex items-baseline gap-1 px-2.5 py-1 rounded-md text-sm font-mono bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 shadow-2xs">
								<code>5</code> <span class="font-sans text-xs text-zinc-400 dark:text-zinc-500">(5 minutes)</span>
							</span>
							<span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-mono bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 shadow-2xs">
								<code>2mins</code>
							</span>
							<span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-mono bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 shadow-2xs">
								<code>02:00</code>
							</span>
							<span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-mono bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 shadow-2xs">
								<code>1hr 30mins</code>
							</span>
							<span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-mono bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 shadow-2xs">
								<code>90s</code>
							</span>
						</div>
						<p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2.5 leading-relaxed">
							Entering a plain number like <code class="font-mono text-zinc-700 dark:text-zinc-300">5</code> defaults to five minutes according to current product behavior.
						</p>
					</div>

					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Control the countdown using <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Start</span>, <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Pause</span>, <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Resume</span>, <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Reset</span>, and <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Stop</span>.
					</p>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Pressing <strong class="font-medium text-zinc-900 dark:text-zinc-100">Reset</strong> restores the countdown back to your initial configured duration. Pressing <strong class="font-medium text-zinc-900 dark:text-zinc-100">Stop</strong> ends the active timer immediately and marks the session completed.
					</p>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						When Timer reaches <code class="font-mono text-zinc-800 dark:text-zinc-200">00:00</code>, an optional soft completion sound plays if enabled in the header settings.
					</p>
				</section>

				<!-- Clock Section -->
				<section id="clock" class="scroll-mt-20 pt-10 sm:pt-14 border-t border-zinc-200 dark:border-zinc-800 space-y-4">
					<h2 class="text-2xl sm:text-[1.65rem] font-semibold text-zinc-950 dark:text-zinc-50 tracking-tight">Clock</h2>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Clock displays the current local time reported by your device. You can toggle between 12-hour and 24-hour formats inside the Settings menu.
					</p>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Clock mode works across all three visual styles (Modern, Digital, Analog). In Analog style, a small <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">AM</span> or <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">PM</span> badge is shown on the dial face when 12-hour mode is selected.
					</p>
					<p class="text-sm text-zinc-500 dark:text-zinc-400">
						Note: Clock mode runs independently and does not drive Current Task timing.
					</p>
				</section>

				<!-- Stopwatch Section -->
				<section id="stopwatch" class="scroll-mt-20 pt-10 sm:pt-14 border-t border-zinc-200 dark:border-zinc-800 space-y-4">
					<h2 class="text-2xl sm:text-[1.65rem] font-semibold text-zinc-950 dark:text-zinc-50 tracking-tight">Stopwatch</h2>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Stopwatch measures elapsed time upwards from zero.
					</p>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Controls include <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Start</span>, <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Pause</span>, <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Resume</span>, <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Reset</span>, and <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">Stop</span>.
					</p>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Pressing <strong class="font-medium text-zinc-900 dark:text-zinc-100">Stop</strong> halts timing while preserving the final elapsed Stopwatch value on screen. Pressing <strong class="font-medium text-zinc-900 dark:text-zinc-100">Reset</strong> returns the elapsed time back to zero.
					</p>
				</section>

				<!-- Mini To-do Section -->
				<section id="todo" class="scroll-mt-20 pt-10 sm:pt-14 border-t border-zinc-200 dark:border-zinc-800 space-y-4">
					<h2 class="text-2xl sm:text-[1.65rem] font-semibold text-zinc-950 dark:text-zinc-50 tracking-tight">Mini To-do</h2>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						The To-do panel lets you manage work items alongside the active timer. Tasks progress through three distinct states:
					</p>

					<!-- Task States Grid -->
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-4">
						<div class="p-3.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50">
							<div class="flex items-center gap-2 mb-1.5">
								<span class="w-2 h-2 rounded-full bg-rose-400 shrink-0" aria-hidden="true"></span>
								<span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Pending</span>
							</div>
							<p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">Queued tasks awaiting work.</p>
						</div>
						<div class="p-3.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50">
							<div class="flex items-center gap-2 mb-1.5">
								<span class="w-2 h-2 rounded-full bg-amber-400 shrink-0" aria-hidden="true"></span>
								<span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Current</span>
							</div>
							<p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">Active work items being timed (up to 2 at once).</p>
						</div>
						<div class="p-3.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50">
							<div class="flex items-center gap-2 mb-1.5">
								<span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0" aria-hidden="true"></span>
								<span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Completed</span>
							</div>
							<p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">Finished items sorted below active tasks.</p>
						</div>
					</div>

					<ul class="space-y-2.5 text-sm sm:text-[15px] text-zinc-700 dark:text-zinc-300">
						<li class="flex items-start gap-2">
							<span class="font-medium text-zinc-950 dark:text-zinc-50 shrink-0">Creating tasks:</span>
							<span>Type a task title in the input box and press Enter. New tasks are added as Pending.</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="font-medium text-zinc-950 dark:text-zinc-50 shrink-0">Current tasks:</span>
							<span>You can promote up to two tasks simultaneously to Current by clicking the play icon on any Pending item.</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="font-medium text-zinc-950 dark:text-zinc-50 shrink-0">Completing tasks:</span>
							<span>Click the checkmark on an active task to mark it done. Completed tasks automatically move below unfinished tasks with their recorded work duration preserved.</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="font-medium text-zinc-950 dark:text-zinc-50 shrink-0">Returning tasks:</span>
							<span>A Current Task can be returned to Pending using the return button without losing its logged time.</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="font-medium text-zinc-950 dark:text-zinc-50 shrink-0">Restarting & deleting:</span>
							<span>Completed tasks can be restarted back to Pending or deleted entirely. Pending tasks can also be removed when no longer needed.</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="font-medium text-zinc-950 dark:text-zinc-50 shrink-0">Summary counter:</span>
							<span>The summary bar at the bottom tracks total <strong class="font-medium text-zinc-900 dark:text-zinc-100">Done X &middot; Remaining Y</strong> items.</span>
						</li>
					</ul>
				</section>

				<!-- Current Task Timing Section -->
				<section id="task-timing" class="scroll-mt-20 pt-10 sm:pt-14 border-t border-zinc-200 dark:border-zinc-800 space-y-4">
					<h2 class="text-2xl sm:text-[1.65rem] font-semibold text-zinc-950 dark:text-zinc-50 tracking-tight">Current Task Timing</h2>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Each Current Task records its own elapsed work duration. If two Current Tasks are active at the same time, both record active time simultaneously, though each keeps its own independent duration based on when it was promoted.
					</p>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Task timing strictly mirrors the active session:
					</p>
					<ul class="list-disc pl-5 space-y-2 text-sm sm:text-[15px] text-zinc-700 dark:text-zinc-300">
						<li>Tasks accumulate time only while a Timer or Stopwatch session is actively running.</li>
						<li>Pausing a Timer or Stopwatch pauses task duration accumulation immediately.</li>
						<li>Changing visual display styles (Modern, Digital, Analog) or display sizes (Tiny, Mid, Big, Full) does not interrupt or reset task timing.</li>
					</ul>
				</section>

				<!-- Study Block Presets Section -->
				<section id="presets" class="scroll-mt-20 pt-10 sm:pt-14 border-t border-zinc-200 dark:border-zinc-800 space-y-4">
					<h2 class="text-2xl sm:text-[1.65rem] font-semibold text-zinc-950 dark:text-zinc-50 tracking-tight">Study Block Presets</h2>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Study Block Presets are optional predefined Timer sequences intended to help structure a study session. Selecting a preset from the Settings menu switches to Timer mode and starts the first segment automatically.
					</p>
					<p class="text-base sm:text-[16px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
						Each segment displays an active phase label (such as <em class="text-zinc-900 dark:text-zinc-100">Learn</em>, <em class="text-zinc-900 dark:text-zinc-100">Recall</em>, <em class="text-zinc-900 dark:text-zinc-100">Solve</em>, <em class="text-zinc-900 dark:text-zinc-100">Review</em>, <em class="text-zinc-900 dark:text-zinc-100">Study</em>, or <em class="text-zinc-900 dark:text-zinc-100">Practice</em>) directly underneath the Timer display.
					</p>
					<ul class="list-disc pl-5 space-y-2 text-sm sm:text-[15px] text-zinc-700 dark:text-zinc-300">
						<li>The phase label indicates the current study block segment; it is not a Current Task and is not added to the Mini To-do.</li>
						<li>Segments automatically advance to the next phase when the countdown finishes.</li>
						<li>The Timer completes and stops after the final preset segment finishes (presets do not loop).</li>
						<li>Pause, Resume, Reset, and Stop controls work normally throughout a preset session.</li>
					</ul>

					<!-- Existing Presets Grid -->
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 my-4">
						<div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50">
