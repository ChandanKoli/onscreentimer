---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Layout title="Guide On Screen Timer — Minuteur, Tâches et Blocs d'étude" description="Explications pratiques pour utiliser On Screen Timer efficacement.">
	<div class="min-h-dvh flex flex-col">
		<!-- Header -->
		<SiteHeader />

		<!-- Hub Content -->
		<main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-zinc-800 dark:text-zinc-200">
			<!-- Introductory Hero -->
			<div class="mb-16 sm:mb-20">
				<h1 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-zinc-950 dark:text-zinc-50 tracking-tight leading-[1.15] mb-4">
					Guides
				</h1>
				<p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
					Explications pratiques pour utiliser On Screen Timer et tirer le meilleur parti de son minuteur, ses tâches, ses blocs d'étude et ses options d'affichage.
				</p>
			</div>

			<!-- Guides List -->
			<div class="space-y-12 sm:space-y-16">

				<!-- Guide: Premiers pas -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/fr/guide/getting-started" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Premiers pas avec On Screen Timer
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Découvrez les bases du Minuteur, de l'Horloge, du Chronomètre et des commandes principales.
					</p>
					<a href="/fr/guide/getting-started" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Lire le guide &rarr;
					</a>
				</article>

				<!-- Guide: Saisie et contrôles du minuteur -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/fr/guide/timer-inputs-and-controls" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Saisie de durée et contrôles du minuteur
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Apprenez à saisir des durées et à contrôler le compte à rebours actif du Minuteur.
					</p>
					<a href="/fr/guide/timer-inputs-and-controls" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Lire le guide &rarr;
					</a>
				</article>

				<!-- Guide: Tâches et chronométrage -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/fr/guide/tasks" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Tâches et chronométrage de la tâche en cours
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Découvrez comment les tâches En attente, En cours et Terminées fonctionnent avec votre minuteur.
					</p>
					<a href="/fr/guide/tasks" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Lire le guide &rarr;
					</a>
				</article>

				<!-- Guide: Modèles de blocs d'étude -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/fr/guide/study-block-presets" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Modèles de blocs d'étude
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Découvrez comment les séquences d'étude prédéfinies de On Screen Timer divisent une session du Minuteur en phases nommées.
					</p>
					<a href="/fr/guide/study-block-presets" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Lire le guide &rarr;
					</a>
				</article>

				<!-- Guide: Styles d'affichage, tailles et mode Plein écran -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/fr/guide/display-modes" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Styles d'affichage, tailles et mode Plein écran
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Découvrez les styles visuels, le redimensionnement du minuteur et l'utilisation du mode Plein écran focalisé.
					</p>
					<a href="/fr/guide/display-modes" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Lire le guide &rarr;
					</a>
				</article>

				<!-- Guide: Enregistrement de la session -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/fr/guide/saving-your-session" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Enregistrement de votre session
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Découvrez comment On Screen Timer enregistre vos préférences et tâches actives localement dans votre navigateur.
					</p>
					<a href="/fr/guide/saving-your-session" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Lire le guide &rarr;
					</a>
				</article>

				<!-- Guide: Clavier, son et paramètres -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/fr/guide/controls-and-settings" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Clavier, son et paramètres
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Découvrez les raccourcis clavier utiles, les paramètres audio et les préférences générales.
					</p>
					<a href="/fr/guide/controls-and-settings" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Lire le guide &rarr;
					</a>
				</article>

				<!-- Guide: Utiliser On Screen Timer pour l'étude et la concentration -->
				<article class="flex flex-col items-start pb-12 sm:pb-16 border-b border-zinc-200 dark:border-zinc-800/80 last:border-0 last:pb-0">
					<h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight mb-2 sm:mb-3">
						<a href="/fr/guide/study-and-focus" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
							Utiliser On Screen Timer pour l'étude et la concentration
						</a>
					</h2>
					<p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
						Conseils pratiques pour utiliser le minuteur, les tâches et les modèles afin de structurer vos sessions d'étude.
					</p>
					<a href="/fr/guide/study-and-focus" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
						Lire le guide &rarr;
					</a>
				</article>

			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>

<script>
	// Theme Switcher
	const themeBtn = document.getElementById('btn-theme');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('ost_theme', isDark ? 'dark' : 'light');
			} catch {
				// Ignore quota/storage access errors
			}
		});
	}
</script>
