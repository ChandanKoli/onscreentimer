---
import '../styles/global.css';
import { SITE_CONFIG } from '../site.config';
import { getLocaleFromUrl } from '../i18n/utils';
import { LOCALES, ACTIVE_LOCALES } from '../i18n/config';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';

interface Props {
	title?: string;
	description?: string;
	ogType?: string;
}

const {
	title = 'Online Timer, Clock & Stopwatch — On Screen Timer',
	description = 'A free, full-screen online timer, clock, and stopwatch with built-in task tracking. Distraction-free, easy to use, and works directly in your browser.',
	ogType = 'website'
} = Astro.props;

const currentLocaleId = getLocaleFromUrl(Astro.url);
const localeConfig = LOCALES[currentLocaleId];

// Extract base path without locale prefix
let basePath = Astro.url.pathname;
if (localeConfig.prefix && basePath.startsWith(localeConfig.prefix)) {
    basePath = basePath.slice(localeConfig.prefix.length);
}
if (!basePath.startsWith('/')) basePath = '/' + basePath;
const cleanPath = basePath.startsWith('/') ? basePath.slice(1) : basePath;

// Ensure trailing slash logic is consistent or just rely on Astro's pathname
// Astro.url.pathname often has a trailing slash for the root, e.g. '/'
const canonicalPath = localeConfig.prefix === '' ? `/${cleanPath}` : `${localeConfig.prefix}/${cleanPath}`;
const canonicalURL = new URL(canonicalPath.replace(/\/{2,}/g, '/'), SITE_CONFIG.url).href;

const activeHreflangs = ACTIVE_LOCALES.map(loc => {
    const altPath = loc.prefix === '' ? `/${cleanPath}` : `${loc.prefix}/${cleanPath}`;
    return {
        lang: loc.lang,
        url: new URL(altPath.replace(/\/{2,}/g, '/'), SITE_CONFIG.url).href
    };
});

const xDefaultPath = LOCALES['en'].prefix === '' ? `/${cleanPath}` : `${LOCALES['en'].prefix}/${cleanPath}`;
const xDefaultUrl = new URL(xDefaultPath.replace(/\/{2,}/g, '/'), SITE_CONFIG.url).href;
---
<!doctype html>
<html lang={localeConfig.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="OS Timer" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		
		{activeHreflangs.map(({ lang, url }) => (
			<link rel="alternate" hreflang={lang} href={url} />
		))}
		<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_CONFIG.name} />
		<!-- <meta property="og:image" content={new URL("/og-image.png", SITE_CONFIG.url)} /> -->

		<slot name="head" />

		<script is:inline>
			(function () {
				try {
					const theme = localStorage.getItem('ost_theme');
					if (theme === 'dark') {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
				} catch {
					// Fallback for restricted storage environments
				}
			})();
		</script>
	</head>
	<body data-size="mid" class="group/body min-h-dvh bg-zinc-50 text-zinc-950 dark:bg-zinc-950 dark:text-zinc-50 font-sans antialiased selection:bg-blue-500/20 selection:text-blue-700 dark:selection:text-blue-300 flex flex-col">
		<slot />
		<AnalyticsConsent />
	</body>
</html>
